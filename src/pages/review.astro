---
import Review from '../components/review/Review.svelte';
import Base from '../layouts/Base.astro';
---

<Base title="วิจารณ์เกม">
  <p class="eyebrow">หลังเกม · รู้ว่าพลาดตรงไหน</p>
  <h1>วิจารณ์เกม</h1>
  <p class="how">
    เกมที่คุณเล่นจบจะถูกเก็บไว้ในเบราว์เซอร์นี้ แต่ละเทิร์นของคุณได้ win% หลังจบเทิร์น ป้ายพลาดชัด / น่าจะมีทางที่ดีกว่า
    ทางที่บอทจะเล่น และสนามตอนนั้นแบบเปิดการ์ดทุกใบ กด "ลองเล่นใหม่จากตรงนี้" เพื่อเล่นเทิร์นนั้นใหม่ด้วยการ์ดชุดเดิม
  </p>
  <Review client:only="svelte" />
</Base>

<style>
  h1 {
    margin: 0 0 4px;
  }
  .how {
    margin: 0 0 16px;
    color: var(--ink-soft);
    font-size: 0.9rem;
    max-width: 80ch;
  }
</style>
