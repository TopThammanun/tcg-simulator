---
import Base from '../layouts/Base.astro';
import { archetypes, loadDecks } from '../lib/decks';
import limitless from '../../data/meta/limitless.json';

const decks = await loadDecks();
const opponents = archetypes(decks);
const maxShare = Math.max(...opponents.map((a) => a.metaShare));
const updated = new Date(limitless.fetched).toLocaleDateString('th-TH', { dateStyle: 'medium' });

// The hero's row of cards: each archetype's headline Pokémon (the one the deck is named after, else its biggest rule-box Pokémon).
type Line = (typeof decks)[number]['lines'][number];
const score = (deckName: string, l: Line) =>
  (deckName.includes(l.card.name.replace(/^Mega | ex$/g, '')) ? 1000 : 0) + (l.card.category === 'pokemon' ? l.card.prizes * 10 : 0) + l.entry.count;
const fan = opponents
  .slice(0, 5)
  .map((a) => {
    const d = decks.find((x) => x.slug === a.slugs[0])!;
    const best = d.lines
      .filter((l) => l.entry.section === 'pokemon' && l.print.image.high)
      .sort((x, y) => score(d.meta.name, y) - score(d.meta.name, x))[0];
    return best && { src: best.print.image.high!, name: best.card.name, deck: a.name };
  })
  .filter((x) => !!x);

const features = [
  {
    title: 'บอทเล่นเด็ค meta',
    text: 'list จากทัวร์นาเมนต์ล่าสุดบน Limitless สุ่มคู่แข่งตามสัดส่วนที่เจอจริง หรือเลือกซ้อม matchup ที่อยากซ้อม',
  },
  {
    title: 'เล่นเหมือนโต๊ะจริง',
    text: 'ค้นเด็คแล้วเห็นทั้งเด็ค การ์ดที่กำลังใช้ขึ้นกลางสนามจนเอฟเฟกต์จบ ไม่มีตัวช่วยหรือย้อน ตามกฎ Standard',
  },
  {
    title: 'ทบทวนเกม',
    text: 'เล่นจบแล้วดูว่าเทิร์นไหนที่เกมพลิก บอทจะเล่นต่างจากคุณตรงไหน แล้วลองเล่นเทิร์นนั้นใหม่',
  },
];
---

<Base title="หน้าแรก">
  <section class="hero">
    <div class="pitch">
      <p class="eyebrow">Pokémon TCG · Standard</p>
      <h1>ซ้อม matchup<br />กับเด็คใน meta</h1>
      <p class="lede">
        เลือกเด็คที่คุณจะเล่น หรือวาง list ของคุณเอง แล้วเล่นกับบอทที่ใช้เด็คอันดับต้นของ meta ตามกฎจริง ในเบราว์เซอร์
        ไม่ต้องสมัครสมาชิก
      </p>
      <div class="ctas">
        <a class="cta" href="/play/">เล่นกับบอท</a>
        <a class="cta alt" href="/decks/">ดูเด็คทั้งหมด</a>
      </div>
    </div>
    <figure class="spread">
      <div class="cards" aria-hidden="true">
        {fan.map((c, i) => <img src={c.src} alt="" width="600" height="825" style={`--i:${i}`} />)}
      </div>
      <figcaption>เด็คอันดับ 1–{fan.length} ตามสัดส่วนบน Limitless</figcaption>
    </figure>
  </section>

  <section class="features" aria-label="ทำอะไรได้บ้าง">
    {
      features.map((f, i) => (
        <div>
          <span class="mono num">{String(i + 1).padStart(2, '0')}</span>
          <h2>{f.title}</h2>
          <p>{f.text}</p>
        </div>
      ))
    }
  </section>

  <section class="meta" aria-labelledby="meta-title">
    <header>
      <h2 id="meta-title">คู่แข่งตอนนี้</h2>
      <p class="note">สัดส่วนใน meta จาก Limitless · อัปเดต {updated}</p>
    </header>
    <table>
      <thead>
        <tr>
          <th class="rank" scope="col">อันดับ</th>
          <th scope="col">เด็ค</th>
          <th class="share" scope="col">สัดส่วน</th>
          <th class="pct" scope="col">%</th>
        </tr>
      </thead>
      <tbody>
        {
          opponents.map((a, i) => (
            <tr>
              <td class="rank mono">{i + 1}</td>
              <td>
                <a href={`/decks/${a.slugs[0]}/`}>{a.name}</a>
              </td>
              <td class="share">
                <span class="bar" style={`--w:${(a.metaShare / maxShare) * 100}%`} />
              </td>
              <td class="pct mono">{a.metaShare.toFixed(1)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 30rem);
    align-items: center;
    gap: 48px;
    padding: 24px 0 40px;
  }
  .eyebrow {
    margin-bottom: 14px;
  }
  h1 {
    font-size: clamp(2.2rem, 5.2vw, 3.6rem);
    font-weight: 700;
    margin: 0 0 18px;
  }
  .lede {
    max-width: 52ch;
    font-size: 1.08rem;
    color: var(--ink-soft);
    margin: 0 0 28px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .cta {
    display: inline-block;
    padding: 11px 22px;
    border: 1px solid var(--primary);
    border-radius: var(--radius);
    background: var(--primary);
    color: var(--primary-ink);
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .cta:hover {
    background: var(--press);
    border-color: var(--press);
  }
  .cta.alt {
    background: transparent;
    border-color: var(--line);
    color: var(--ink);
  }
  .cta.alt:hover {
    border-color: var(--ink);
    background: transparent;
  }
  /* The top decks' headline Pokémon laid flat in a row, each over the one before. */
  .spread {
    margin: 0;
  }
  .cards {
    position: relative;
    height: calc(9rem * 88 / 63);
  }
  .cards img {
    position: absolute;
    top: 0;
    left: calc(var(--i) * 5.25rem);
    width: 9rem;
    height: auto;
    border-radius: 4.5% / 3.2%;
    box-shadow:
      0 0 0 1px #15181d1a,
      -6px 0 16px -10px #15181d80;
  }
  .spread figcaption {
    margin-top: 12px;
    color: var(--ink-soft);
    font-size: 0.8rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .cards img {
      animation: lay 0.5s ease-out backwards;
      animation-delay: calc(80ms + var(--i) * 60ms);
    }
    @keyframes lay {
      from {
        opacity: 0;
        transform: translateX(-12px);
      }
    }
  }
  .features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    padding: 36px 0 12px;
  }
  .features div {
    padding-top: 14px;
    border-top: 2px solid var(--ink);
  }
  .num {
    display: block;
    color: var(--ink-soft);
    font-size: 0.8rem;
    margin-bottom: 6px;
  }
  .features h2 {
    font-size: 1.15rem;
    margin: 0 0 6px;
  }
  .features p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }
  .meta {
    margin-top: 48px;
  }
  .meta header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
    margin-bottom: 8px;
  }
  .meta h2 {
    font-size: 1.5rem;
    margin: 0;
  }
  .note {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.8rem;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    border-top: 2px solid var(--ink);
  }
  th {
    padding: 8px 10px;
    border-bottom: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.78rem;
    font-weight: 600;
    text-align: left;
  }
  td {
    padding: 11px 10px;
    border-bottom: 1px solid var(--rule);
  }
  tbody tr:hover {
    background: var(--card-bg);
  }
  .rank {
    width: 4.5rem;
    color: var(--ink-soft);
  }
  td a {
    font-weight: 600;
    text-decoration: none;
  }
  td a:hover {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .share {
    width: 45%;
  }
  .bar {
    display: block;
    height: 6px;
    background: linear-gradient(to right, var(--primary) var(--w), var(--paper-deep) var(--w));
  }
  .pct {
    width: 4.5rem;
    text-align: right;
    font-weight: 500;
  }
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-bottom: 36px;
    }
    .cards {
      height: calc(6rem * 88 / 63);
    }
    .cards img {
      width: 6rem;
      left: calc(var(--i) * 3.6rem);
    }
  }
  @media (max-width: 640px) {
    .features {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .share {
      display: none;
    }
    .rank {
      width: 3rem;
    }
  }
</style>
