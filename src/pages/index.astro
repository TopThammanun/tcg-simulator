---
import Base from '../layouts/Base.astro';
import { archetypes, loadDecks } from '../lib/decks';
import limitless from '../../data/meta/limitless.json';

const decks = await loadDecks();
const opponents = archetypes(decks);
const maxShare = Math.max(...opponents.map((a) => a.metaShare));
const updated = new Date(limitless.fetched).toLocaleDateString('th-TH', { dateStyle: 'medium' });

// The hero's fan: each archetype's headline Pokémon (the one the deck is named after, else its biggest rule-box Pokémon).
type Line = (typeof decks)[number]['lines'][number];
const score = (deckName: string, l: Line) =>
  (deckName.includes(l.card.name.replace(/^Mega | ex$/g, '')) ? 1000 : 0) + (l.card.category === 'pokemon' ? l.card.prizes * 10 : 0) + l.entry.count;
const fan = opponents
  .slice(0, 5)
  .map((a) => {
    const d = decks.find((x) => x.slug === a.slugs[0])!;
    const best = d.lines
      .filter((l) => l.entry.section === 'pokemon' && l.print.image.high)
      .sort((x, y) => score(d.meta.name, y) - score(d.meta.name, x))[0];
    return best && { src: best.print.image.high!, name: best.card.name, deck: a.name };
  })
  .filter((x) => !!x);

const features = [
  {
    title: 'บอทเล่นเด็ค meta',
    text: 'list จากทัวร์นาเมนต์ล่าสุดบน Limitless สุ่มคู่แข่งตามสัดส่วนที่เจอจริง หรือเลือกซ้อม matchup ที่อยากซ้อม',
  },
  {
    title: 'โหมดฝึก',
    text: 'บอกโอกาสที่ Pokémon แต่ละตัวโดน KO เทิร์นหน้า แนะนำ 3 ทางเลือกพร้อมเหตุผล และย้อนได้โดยสับการ์ดที่มองไม่เห็นใหม่',
  },
  {
    title: 'ทบทวนเกม',
    text: 'เล่นจบแล้วดูว่าเทิร์นไหนที่เกมพลิก บอทจะเล่นต่างจากคุณตรงไหน แล้วลองเล่นเทิร์นนั้นใหม่',
  },
];
---

<Base title="หน้าแรก">
  <section class="hero">
    <div class="pitch">
    <p class="eyebrow">Pokémon TCG · ซ้อมกับบอท</p>
    <h1>ซ้อม matchup<br /><span>กับเด็คใน meta</span></h1>
    <p class="lede">
      เลือกเด็คที่คุณจะเล่น หรือวาง list ของคุณเอง แล้วเล่นกับบอทที่ใช้เด็คอันดับต้นของ meta ตามกฎจริง ในเบราว์เซอร์
      ไม่ต้องสมัครสมาชิก
    </p>
    <span class="ctas">
      <a class="cta" href="/play/">เล่นกับบอท →</a>
      <a class="cta alt" href="/decks/">ดูเด็คทั้งหมด</a>
    </span>
    </div>
    <div class="fan" aria-hidden="true">
      {
        fan.map((c, i) => (
          <img src={c.src} alt="" width="600" height="825" style={`--i:${i}; --o:${i - (fan.length - 1) / 2}`} />
        ))
      }
      <span class="stamp">TOP {fan.length}<br />META</span>
    </div>
  </section>

  <section class="features" aria-label="ทำอะไรได้บ้าง">
    {
      features.map((f) => (
        <div>
          <h2>{f.title}</h2>
          <p>{f.text}</p>
        </div>
      ))
    }
  </section>

  <section class="meta">
    <h2>คู่แข่งตอนนี้</h2>
    <ol>
      {
        opponents.map((a) => (
          <li>
            <a href={`/decks/${a.slugs[0]}/`}>{a.name}</a>
            <span class="bar" style={`--w:${(a.metaShare / maxShare) * 100}%`} />
            <span class="mono pct">{a.metaShare.toFixed(1)}%</span>
          </li>
        ))
      }
    </ol>
    <p class="note">สัดส่วนใน meta จาก Limitless · อัปเดต {updated}</p>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: 24px;
    padding: 24px 0 32px;
    border-bottom: 2px solid var(--ink);
    overflow: hidden;
  }
  /* Five cards fanned from a point below, like a hand held up; the stamp sits over them. */
  .fan {
    position: relative;
    height: 23rem;
  }
  .fan img {
    position: absolute;
    left: calc(44% - 5.6rem + var(--o) * 3.9rem);
    bottom: 1.2rem;
    width: 11.2rem;
    height: auto;
    border-radius: 9px;
    box-shadow: 0 1px 0 #fff8 inset, 0 18px 30px -16px #3a2f1a99;
    transform: rotate(calc(var(--o) * 9deg)) translateY(calc(var(--o) * var(--o) * 9px));
    transform-origin: 50% 120%;
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .fan:hover img {
    transform: rotate(calc(var(--o) * 12deg)) translateY(calc(var(--o) * var(--o) * 11px - 6px));
  }
  .stamp {
    position: absolute;
    right: 4%;
    top: 4%;
    z-index: 6;
    padding: 6px 12px;
    border: 3px solid var(--stamp);
    color: var(--stamp);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.1;
    text-align: center;
    letter-spacing: 0.06em;
    background: color-mix(in srgb, var(--paper) 80%, transparent);
    transform: rotate(12deg);
    mix-blend-mode: multiply;
  }
  @media (prefers-reduced-motion: no-preference) {
    .fan img {
      animation: deal 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
      animation-delay: calc(120ms + var(--i) * 70ms);
    }
    .stamp {
      animation: thump 0.35s cubic-bezier(0.3, 1.6, 0.5, 1) 0.65s backwards;
    }
    @keyframes deal {
      from {
        opacity: 0;
        transform: translateY(60px) rotate(0deg);
      }
    }
    @keyframes thump {
      from {
        opacity: 0;
        transform: rotate(12deg) scale(1.6);
      }
    }
  }
  h1 {
    font-size: clamp(2.6rem, 8vw, 5.4rem);
    margin: 0 0 16px;
    /* room for Thai marks above and below the line */
    line-height: 1.18;
  }
  h1 span {
    color: var(--stamp);
  }
  .lede {
    max-width: 56ch;
    font-size: 1.1rem;
    color: var(--ink-soft);
    margin: 0 0 24px;
  }
  .cta {
    display: inline-block;
    padding: 10px 18px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
    box-shadow: 4px 4px 0 var(--stamp);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .cta:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--stamp);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .cta.alt {
    background: transparent;
    color: var(--ink);
    border: 2px solid var(--ink);
    box-shadow: none;
  }
  .features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-bottom: 1px solid var(--rule);
  }
  .features div {
    padding: 18px 16px 18px 0;
  }
  .features div + div {
    border-left: 1px solid var(--rule);
    padding-left: 16px;
  }
  .features h2 {
    font-size: 1.1rem;
    margin: 0 0 6px;
  }
  .features p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .meta h2 {
    font-size: 1.2rem;
    margin: 28px 0 8px;
  }
  .meta ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .meta li {
    display: grid;
    grid-template-columns: minmax(0, 16rem) 1fr 4.2rem;
    gap: 12px;
    align-items: center;
    padding: 8px 4px;
    border-bottom: 1px solid var(--rule);
  }
  .meta a {
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
  }
  .meta a:hover {
    color: var(--stamp);
  }
  .bar {
    height: 10px;
    background: linear-gradient(to right, var(--stamp) var(--w), var(--paper-deep) var(--w));
    border: 1px solid var(--ink);
  }
  .pct {
    font-size: 0.85rem;
    font-weight: 600;
    text-align: right;
  }
  .note {
    color: var(--ink-soft);
    font-size: 0.8rem;
  }
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .fan {
      order: -1;
      height: 13rem;
      margin: -8px 0 4px;
    }
    .fan img {
      width: 6.6rem;
      left: calc(50% - 3.3rem + var(--o) * 2.6rem);
      bottom: 0.4rem;
    }
    .stamp {
      right: 2%;
      font-size: 0.85rem;
    }
  }
  @media (max-width: 640px) {
    .features {
      grid-template-columns: 1fr;
    }
    .features div + div {
      border-left: 0;
      border-top: 1px solid var(--rule);
      padding-left: 0;
    }
    .meta li {
      grid-template-columns: 1fr 4.2rem;
    }
    .bar {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
