---
import Game from '../../components/game/Game.svelte';
import { deckKeys } from '../../engine/db';
import { langPaths, tFor } from '../../i18n';
import Base from '../../layouts/Base.astro';
import { loadDecks, metaDecks } from '../../lib/decks';
import type { MetaDeck } from '../../ui/decks';

export function getStaticPaths() {
  return langPaths();
}

const t = tFor(Astro.props.lang);

const decks: MetaDeck[] = metaDecks(await loadDecks()).map((d) => ({
  slug: d.slug,
  name: d.meta.name,
  rank: d.meta.rank,
  metaShare: d.meta.metaShare,
  archetype: d.meta.limitless ?? d.slug,
  cards: deckKeys(d.lines.map((l) => l.entry)),
}));
---

<Base
  title={t('เล่น Pokémon TCG กับบอท', 'Play Pokémon TCG against the bot')}
  description={t(
    'เล่น Pokémon TCG กับบอท AI ในเบราว์เซอร์ ฟรี ไม่ต้องสมัคร เลือกเด็คของคุณ เลือกเด็คคู่แข่งจาก meta แล้วเล่นตามกฎ Standard เหมือนนั่งอยู่ที่โต๊ะจริง',
    'Play the Pokémon TCG against an AI bot in your browser, free and with no sign-up: pick your deck and a meta deck, and play under Standard rules as at a real table.',
  )}
  words={t('เล่น Pokémon TCG ออนไลน์,เล่นการ์ดโปเกมอนกับบอท', 'play Pokémon TCG online,Pokémon TCG bot').split(',')}
>
  <Game client:only="svelte" {decks} />
</Base>
