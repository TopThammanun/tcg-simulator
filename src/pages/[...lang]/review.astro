---
import Review from '../../components/review/Review.svelte';
import { langPaths, tFor } from '../../i18n';
import Base from '../../layouts/Base.astro';
import { gymLeaders, loadDecks } from '../../lib/decks';

export function getStaticPaths() {
  return langPaths();
}

const t = tFor(Astro.props.lang);
// The gym's leaders and their badges, for your badge case (beat a deck, earn its badge).
const gyms = gymLeaders(await loadDecks()).map(({ name, slugs, shape, type }) => ({ name, slugs, shape, type }));
---

<Base
  title={t('ประวัติเกมและรีวิวเกม Pokémon TCG', 'Pokémon TCG game history and review')}
  description={t(
    'รีวิวเกม Pokémon TCG ที่คุณเล่นกับบอท ดู win% ทุกเทิร์น รู้ว่าพลาดตรงไหน ถ้าเล่นอีกทางจะได้อะไร และควรเผื่อเทิร์นหน้าของอีกฝั่งยังไง',
    'Review your Pokémon TCG games against the bot: win% on every turn, the turns you slipped, what the better way gets you and what to play around next turn.',
  )}
  words={t('รีวิวเกม,วิเคราะห์เกม Pokémon TCG,play around', 'game review,Pokémon TCG analysis,play around').split(',')}
>
  <header class="page-head">
    <p class="eyebrow">{t('โค้ชหลังเกม · เกมพลิกที่เทิร์นไหน', 'Your coach · the turn it turned on')}</p>
    <h1 class="heading-3">{t('ประวัติเกม', 'Game history')}</h1>
    <p class="how body-7">
      {
        t(
          'เกมที่เล่นจบแล้วจะเก็บไว้ในเบราว์เซอร์นี้ กดรีวิวเพื่อดู win% ทุกเทิร์น เทิร์นที่ควรดูก่อน และตรงไหนที่บอทจะเล่นต่างจากคุณ แล้วลองเล่นเทิร์นนั้นใหม่ได้เลย',
          "Every game you finish is kept in this browser. Review one to see your win% on every turn, the turns to look at first and where the bot would have played differently, then play that turn again.",
        )
      }
    </p>
  </header>
  <Review client:only="svelte" {gyms} />
</Base>

<style>
  .page-head {
    max-width: 680px;
    margin-bottom: 40px;
  }
  /* One game's review has its own heading. */
  :global(main:has(.head)) .page-head {
    display: none;
  }
  h1 {
    margin: 0 0 12px;
  }
  .how {
    margin: 0;
    color: var(--ink-soft);
  }
  /* One game's review on a phone: less empty space before the footer. */
  @media (max-width: 640px) {
    :global(main:has(.turn-detail)) {
      padding-bottom: 40px;
    }
  }
</style>
