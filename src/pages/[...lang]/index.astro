---
import DeckCard from '../../components/DeckCard.astro';
import { langPaths, localePath, tFor } from '../../i18n';
import Base from '../../layouts/Base.astro';
import { archetypes, headlines, loadDecks } from '../../lib/decks';
import { SUPPORTED } from '../../ui/decklist';
import limitless from '../../../data/meta/limitless.json';

export function getStaticPaths() {
  return langPaths();
}

const lang = Astro.props.lang;
const t = tFor(lang);
const to = (path: string) => localePath(lang, path);
/** The screenshots, taken of the site in the page's language. */
const shot = (name: string) => `/home/${name}${lang === 'en' ? '-en' : ''}.jpg`;

const decks = await loadDecks();
const opponents = archetypes(decks);
const maxShare = Math.max(...opponents.map((a) => a.metaShare));
const updated = new Date(limitless.fetched).toLocaleDateString(lang === 'en' ? 'en-GB' : 'th-TH', { dateStyle: 'medium' });
const num = (n: number) => n.toLocaleString('en-US');
const artOf = (slug: string) => headlines(decks.find((d) => d.slug === slug)!)[0]?.print.image.high;

const steps = [
  {
    title: t('เลือกเด็ค', 'Pick a deck'),
    text: t(
      'เลือกเด็คใน meta หรือวาง list ที่ export จาก Limitless หรือ Pokémon TCG Live แล้วเลือกคู่แข่ง หรือสุ่มตามสัดส่วนที่เจอจริง',
      'Pick a meta deck or paste a list exported from Limitless or Pokémon TCG Live, then pick an opponent, or let it be drawn by how often each deck is played',
    ),
  },
  {
    title: t('เล่นกับบอท', 'Play the bot'),
    text: t(
      'เล่นตามกฎ Standard เหมือนที่โต๊ะ ค้นเด็คแล้วเห็นทั้งเด็ค เลือก Prize เอง ไม่มีตัวช่วยหรือย้อนตา',
      'Standard rules, as at a real table: a search shows your whole deck, you pick your own Prize cards, and there are no hints or take-backs',
    ),
  },
  {
    title: t('ทบทวนเกม', 'Review the game'),
    text: t(
      'ดู win% ทุกเทิร์น เทิร์นที่เกมพลิก และบอทจะเล่นต่างจากคุณตรงไหน แล้วลองเล่นเทิร์นนั้นใหม่',
      'See your win% on every turn, the turn the game turned on and where the bot would have played differently, then play that turn again',
    ),
  },
];

// The tagline, word by word (Thai has no spaces between words, so the words come from the segmenter).
const TAGLINE =
  lang === 'en'
    ? ['The bots play the same lists as the top players,', "so you practise the matchups you'll meet at real events"]
    : ['บอทเล่น list เดียวกับผู้เล่นที่ติดอันดับ', 'คุณได้ซ้อม matchup ที่จะเจอในทัวร์จริง'];
const segmenter = new Intl.Segmenter(lang, { granularity: 'word' });
const taglineWords = TAGLINE.map((line) => {
  const words: string[] = [];
  for (const { segment, isWordLike } of segmenter.segment(line)) {
    if (!isWordLike && words.length) words[words.length - 1] += segment;
    else words.push(segment);
  }
  return words;
});

const faq = [
  {
    q: t('ต้องสมัครสมาชิกไหม', 'Do I need an account?'),
    a: t(
      'ไม่ต้อง เปิดเว็บแล้วเล่นได้เลย เกมที่เล่นจบและ list ของคุณเก็บไว้ในเบราว์เซอร์นี้',
      'No. Open the site and play. Your finished games and your lists are kept in this browser.',
    ),
  },
  {
    q: t('เด็คของบอทมาจากไหน', "Where do the bots' decks come from?"),
    a: t(
      `list จริงจากทัวร์นาเมนต์บน Limitless เลือกเด็คที่มีสัดส่วนสูงสุดใน ${limitless.days} วันล่าสุด จากทัวร์นาเมนต์ที่มีผู้เล่น ${limitless.minPlayers} คนขึ้นไป อัปเดต ${updated}`,
      `Real lists from tournaments on Limitless: the decks with the largest share in the last ${limitless.days} days, from tournaments with ${limitless.minPlayers} or more players. Updated ${updated}.`,
    ),
  },
  {
    q: t('บอทเล่นเก่งแค่ไหน', 'How well does the bot play?'),
    a: t(
      'บอทใช้ neural network ที่ฝึกจากการเล่นกับตัวเอง และคิดล่วงหน้าหลายทางก่อนเลือกเล่น บอทไม่เห็นการ์ดที่คุณซ่อนอยู่ คาดเดาจากสิ่งที่เปิดแล้วเท่านั้น',
      "The bot uses a neural network trained by playing against itself, and looks ahead along several lines before it plays. It can't see your hidden cards: it only guesses from what has been revealed.",
    ),
  },
  {
    q: t('ใช้ list ของตัวเองได้ไหม', 'Can I use my own list?'),
    a: t(
      `ได้ วาง list ที่หน้าเด็ค ตอนนี้รองรับการ์ด ${SUPPORTED.length} ใบที่เด็คใน meta ใช้ ถ้ามีใบที่ยังไม่รองรับ เว็บจะบอกว่าใบไหน`,
      `Yes. Paste it on the decks page. The ${SUPPORTED.length} cards the meta decks play are supported; if a card isn't yet, the site tells you which.`,
    ),
  },
  {
    q: t('เล่นบนมือถือได้ไหม', 'Can I play on my phone?'),
    a: t(
      'ได้ สนามปรับขนาดตามจอ ลากการ์ดหรือแตะเพื่อเล่น และกดค้างที่การ์ดเพื่ออ่าน',
      'Yes. The table fits the screen: drag or tap cards to play them, and press and hold a card to read it.',
    ),
  },
  {
    q: t('win% ในหน้าทบทวนคำนวณยังไง', 'How is the win% in a review worked out?'),
    a: t(
      'ประเมินด้วย network ของบอทตัวเดียวกับที่คุณเล่นด้วย เฉลี่ยจากการสุ่มการ์ดที่คุณมองไม่เห็นใหม่หลายแบบ เป็นค่าประมาณสำหรับหาเทิร์นที่ควรดูซ้ำ',
      "By the same bot network you played against, averaged over many re-deals of the cards you couldn't see. It's an estimate, for finding the turns worth a second look.",
    ),
  },
];
---

<Base title={t('หน้าแรก', 'Home')}>
  <section class="hero">
    <p class="proof caption-4">
      {t('ข้อมูลจาก Limitless', 'Data from Limitless')} · <span class="mono">{num(limitless.tournaments)}</span> {t('ทัวร์นาเมนต์', 'tournaments')} ·
      <span class="mono">{num(limitless.players)}</span> {t('ผู้เล่น', 'players')} · {t('', 'last')} <span class="mono">{limitless.days}</span> {t('วันล่าสุด', 'days')}
    </p>
    <h1 class="heading-1">
      {t('ซ้อมกับเด็คที่ครอง meta', 'Practise against the decks that rule the meta')}<br />{t('ก่อนเจอกันในทัวร์จริง', 'before you meet them at an event')}
    </h1>
    <p class="sub body-7">
      {t('เลือกเด็คของคุณหรือวาง list เอง แล้วเล่นกับบอทที่ใช้ list จริงจากทัวร์นาเมนต์ล่าสุด', 'Pick your deck or paste your own list, then play bots running real lists from recent tournaments,')}<br />
      {t('ตามกฎ Standard ในเบราว์เซอร์ ไม่ต้องสมัคร', 'under Standard rules, in your browser, with no sign-up')}
    </p>
    <a class="btn primary" href={to('/play/')}>{t('เริ่มเล่นกับบอท', 'Play the bot')}</a>
    <figure class="shot">
      <img
        src={shot('board')}
        alt={t(
          'หน้าจอเกม: สนามของคุณด้านล่าง สนามของบอทด้านบน การ์ดในมือ แถบคำสั่งใต้สนาม และช่องอ่านการ์ดกับ log ด้านขวา',
          "The game screen: your side below, the bot's above, your hand, the command bar under the table, and the card text and log on the right",
        )}
        width="1440"
        height="900"
        fetchpriority="high"
      />
    </figure>
  </section>

  <section class="section" aria-labelledby="meta-title">
    <header class="section-head reveal">
      <div>
        <h2 id="meta-title" class="heading-3">{t('เด็คที่คุณจะเจอ', "The decks you'll face")}</h2>
        <p class="body-3 muted">
          {t(`สัดส่วนใน meta จาก Limitless ${limitless.days} วันล่าสุด อัปเดต ${updated}`, `Meta share on Limitless over the last ${limitless.days} days, updated ${updated}`)}
        </p>
      </div>
      <a class="btn" href={to('/decks/')}>{t('ดู list ทั้งหมด', 'See every list')}</a>
    </header>
    <div class="decks reveal">
      {
        opponents.map((a, i) => (
          <DeckCard
            href={to(`/decks/${a.slugs[0]}/`)}
            name={a.name}
            rank={i + 1}
            share={a.metaShare}
            {maxShare}
            art={artOf(a.slugs[0]!)}
          />
        ))
      }
    </div>
  </section>

  <section class="section" aria-labelledby="how-title">
    <header class="section-head reveal">
      <h2 id="how-title" class="heading-3">{t('ใช้งานยังไง', 'How it works')}</h2>
    </header>
    <ol class="steps">
      {
        steps.map((s, i) => (
          <li class="reveal" style={`--i:${i}`}>
            <span class="mono caption-4 step-no">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="title-1">{s.title}</h3>
            <p class="body-6 muted">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section after" aria-labelledby="after-title">
    <div class="after-text reveal">
      <h2 id="after-title" class="heading-3">{t('หลังเกม ดูว่าเทิร์นไหนเกมพลิก', 'After the game, see the turn it turned on')}</h2>
      <p class="body-3 muted">
        {
          t(
            'ทุกเทิร์นของคุณถูกวิเคราะห์ในเบราว์เซอร์ บอกในประโยคเดียวว่าจุดไหนสำคัญที่สุด กราฟ win% แยกตาคุณกับตาบอท แล้วเปิดเทิร์นนั้นบนสนาม เทียบทางที่คุณเล่นกับทางที่บอทจะเล่นทีละการ์ด',
            "Every turn of yours is analysed in your browser: one sentence on what mattered most, a win% chart with your turns and the bot's apart, then that turn on the table, your way and the bot's way, card by card.",
          )
        }
      </p>
      <a class="btn" href={to('/review/')}>{t('ดูประวัติเกม', 'Game history')}</a>
    </div>
    <figure class="shot after-shot reveal">
      <img
        src={shot('review')}
        alt={t(
          'หน้าทบทวนเกม: ประโยคสรุป สนามของเทิร์นที่ควรดู กราฟ win% และทางที่คุณเล่นเทียบกับทางที่บอทจะเล่น',
          "A game's review: the summary sentence, the table at the turn worth a look, the win% chart, and your way next to the bot's",
        )}
        width="1216"
        height="760"
        loading="lazy"
      />
    </figure>
  </section>

  <section class="tagline-wrap" aria-label={t('สิ่งที่คุณได้', 'What you get')}>
    <p class="tagline heading-3">
      {
        taglineWords.map((line) => (
          <span class="tl">
            {line.map((w) => (
              <span class="w">{w}</span>
            ))}
          </span>
        ))
      }
    </p>
  </section>

  <section class="section faq" aria-labelledby="faq-title">
    <h2 id="faq-title" class="heading-3 reveal">{t('คำถามที่พบบ่อย', 'Questions')}</h2>
    <div class="qa reveal">
      {
        faq.map((f) => (
          <details>
            <summary class="title-2">
              {f.q}
              <span class="plus" aria-hidden="true" />
            </summary>
            <p class="body-3 muted">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="final reveal" aria-labelledby="final-title">
    <h2 id="final-title" class="heading-4">{t('พร้อมซ้อม matchup แรกของคุณ', 'Ready for your first matchup?')}</h2>
    <p class="body-3 muted">{t('เลือกเด็ค เลือกคู่แข่ง แล้วเริ่มเกมได้ทันที', 'Pick a deck, pick an opponent, and start right away')}</p>
    <a class="btn primary" href={to('/play/')}>{t('เริ่มเล่นกับบอท', 'Play the bot')}</a>
  </section>
</Base>

<script>
  // The tagline lights up word by word as it scrolls through the screen (one listener, once per frame).
  const tagline = document.querySelector<HTMLElement>('.tagline');
  const words = tagline ? [...tagline.querySelectorAll<HTMLElement>('.w')] : [];
  if (tagline && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let queued = false;
    const update = () => {
      queued = false;
      const r = tagline.getBoundingClientRect();
      const start = innerHeight * 0.85;
      const end = innerHeight * 0.4;
      const p = (start - r.top) / (start - end + r.height);
      const lit = Math.round(Math.min(1, Math.max(0, p)) * words.length);
      words.forEach((w, i) => w.classList.toggle('on', i < lit));
    };
    addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(update);
      },
      { passive: true },
    );
    update();
  } else words.forEach((w) => w.classList.add('on'));
</script>

<style>
  .muted {
    color: var(--ink-soft);
  }
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 48px 0 0;
    text-align: center;
  }
  .hero > * {
    animation: hero-in 0.7s var(--ease) both;
  }
  .hero > :nth-child(2) {
    animation-delay: 60ms;
  }
  .hero > :nth-child(3) {
    animation-delay: 120ms;
  }
  .hero > :nth-child(4) {
    animation-delay: 180ms;
  }
  .hero > :nth-child(5) {
    animation-delay: 300ms;
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
  }
  .proof {
    margin: 0 0 24px;
    padding: 4px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink-soft);
  }
  .proof .mono {
    color: var(--ink-strong);
  }
  h1 {
    max-width: 680px;
    margin: 0 0 24px;
    background: linear-gradient(90deg, #ffffff, #9b9b9b);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .sub {
    max-width: 680px;
    margin: 0 0 32px;
    color: var(--ink-soft);
  }
  /* The game itself, framed. */
  .shot {
    width: 100%;
    margin: 64px 0 0;
    padding: 8px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-xl);
    background: var(--card-bg);
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }
  .section {
    padding-top: 96px;
  }
  /* After the game: what the review shows, beside a picture of it. */
  .after {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 48px;
    align-items: center;
  }
  .after-text h2 {
    margin: 0 0 16px;
  }
  .after-text p {
    margin: 0 0 24px;
  }
  .after-shot {
    margin: 0;
  }
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 24px;
    margin-bottom: 32px;
  }
  .section-head h2 {
    margin: 0 0 8px;
  }
  .section-head p {
    margin: 0;
  }
  .decks {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .steps li {
    padding-top: 24px;
    border-top: 1px solid var(--line);
    transition-delay: calc(var(--i) * 80ms);
  }
  .step-no {
    color: var(--ink-faint);
  }
  .steps h3 {
    margin: 8px 0 8px;
  }
  .steps p {
    margin: 0;
  }
  /* The tagline: muted until it scrolls into view, then lit word by word. */
  .tagline-wrap {
    padding: 160px 0 64px;
  }
  .tagline {
    max-width: 760px;
    margin: 0 auto;
    color: var(--ink-strong);
    text-align: center;
  }
  .tl {
    display: block;
  }
  .w {
    transition: color 0.5s var(--ease);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .w:not(.on) {
      color: #ededed4d;
    }
  }
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 32px 64px;
    align-items: start;
  }
  .faq h2 {
    margin: 0;
  }
  .qa {
    border-top: 1px solid var(--rule);
  }
  details {
    border-bottom: 1px solid var(--rule);
  }
  summary {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 24px 0;
    color: var(--ink-strong);
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .plus {
    position: relative;
    flex: none;
    width: 16px;
    height: 28px;
  }
  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    top: 13px;
    left: 0;
    width: 16px;
    height: 2px;
    border-radius: 1px;
    background: var(--ink-soft);
    transition: transform 0.5s var(--ease);
  }
  .plus::after {
    transform: rotate(90deg);
  }
  details[open] .plus::after {
    transform: rotate(0deg);
  }
  details p {
    max-width: 640px;
    margin: 0;
    padding: 0 32px 24px 0;
  }
  .final {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 96px;
    padding: 64px 24px;
    border: 1px solid var(--rule);
    border-radius: 24px;
    background: var(--card-bg);
    text-align: center;
  }
  .final h2 {
    margin: 0 0 8px;
  }
  .final p {
    margin: 0 0 24px;
  }
  @media (max-width: 900px) {
    .after {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .decks {
      grid-template-columns: repeat(2, 1fr);
    }
    .steps {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .faq {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .hero {
      padding-top: 24px;
    }
    .decks {
      gap: 8px;
    }
    .proof {
      border-radius: var(--radius-lg);
    }
    .shot {
      margin-top: 48px;
      padding: 4px;
      border-radius: var(--radius-lg);
    }
    .section {
      padding-top: 80px;
    }
    .tagline-wrap {
      padding: 96px 0 32px;
    }
    .final {
      padding: 48px 16px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero > * {
      animation-name: fade;
    }
    @keyframes fade {
      from {
        opacity: 0;
      }
    }
  }
</style>
