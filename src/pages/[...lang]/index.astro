---
import ArenaLines from '../../components/ArenaLines.astro';
import DeckCard from '../../components/DeckCard.astro';
import GymBadge from '../../components/GymBadge.svelte';
import { langPaths, localePath, tFor } from '../../i18n';
import Base from '../../layouts/Base.astro';
import { gymLeaders, headlines, loadDecks } from '../../lib/decks';
import { appLd, faqLd, siteUrl } from '../../lib/seo';
import { SUPPORTED } from '../../ui/decklist';
import limitless from '../../../data/meta/limitless.json';

export function getStaticPaths() {
  return langPaths();
}

const lang = Astro.props.lang;
const t = tFor(lang);
const to = (path: string) => localePath(lang, path);
/** The screenshots, taken of the site in the page's language. */
const shot = (name: string) => `/home/${name}${lang === 'en' ? '-en' : ''}.jpg`;

const decks = await loadDecks();
// The meta decks are the gym's leaders: beat one and its badge is yours (the game list keeps them).
const gyms = gymLeaders(decks);
const maxShare = Math.max(...gyms.map((a) => a.metaShare));
const updated = new Date(limitless.fetched).toLocaleDateString(lang === 'en' ? 'en-GB' : 'th-TH', { dateStyle: 'medium' });
const num = (n: number) => n.toLocaleString('en-US');
const artOf = (slug: string) => headlines(decks.find((d) => d.slug === slug)!)[0]?.print.image.high;

// A trainer's session: warm up, battle, cool down.
const steps = [
  {
    phase: t('วอร์มอัป', 'Warm up'),
    title: t('เลือกเด็ค หรือจัดเอง', 'Pick or build a deck'),
    text: t(
      'หยิบเด็คจาก meta มาใช้ จัดเด็คเองทีละใบ หรือวางลิสต์ที่ export จาก Limitless หรือ Pokémon TCG Live ก็ได้ แล้วเลือกคู่ซ้อม หรือให้สุ่มตามสัดส่วนเด็คที่เจอในทัวร์จริง',
      'Pick a meta deck, build your own by clicking cards in, or paste a list exported from Limitless or Pokémon TCG Live, then pick an opponent, or let it be drawn by how often each deck is played',
    ),
  },
  {
    phase: t('ลงสนาม', 'Battle'),
    title: t('ดวลกับหัวหน้ายิม', 'Play a gym leader'),
    text: t(
      'เล่นตามกฎ Standard เหมือนนั่งอยู่ที่โต๊ะจริง ค้นเด็คก็เห็นทั้งกอง Prize ใบไหนก็เลือกหยิบเอง ไม่มีตัวช่วย ไม่มีขอย้อนตา',
      'Standard rules, as at a real table: a search shows your whole deck, you pick your own Prize cards, and there are no hints or take-backs',
    ),
  },
  {
    phase: t('คูลดาวน์', 'Cool down'),
    title: t('รีวิวเกมกับโค้ช', 'Review with the coach'),
    text: t(
      'ดู win% ทุกเทิร์น รู้ว่าเกมพลิกตอนไหน บอทจะเล่นต่างจากคุณตรงไหน เล่นแบบนั้นแล้วได้อะไร และต้องเผื่อเทิร์นหน้าของอีกฝั่งยังไง จากนั้นลองเล่นเทิร์นนั้นใหม่ได้ทันที',
      'See your win% on every turn, the turn the game turned on, where the bot would have played differently, what that gets you and what it plays around next turn, then play that turn again',
    ),
  },
];

// The tagline, word by word (Thai has no spaces between words, so the words come from the segmenter).
const TAGLINE =
  lang === 'en'
    ? ['Every gym leader plays the same list as the top players,', 'so beat them all here before the real event']
    : ['หัวหน้ายิมทุกคนใช้ลิสต์เดียวกับผู้เล่นท็อปในทัวร์จริง', 'ชนะให้ครบที่นี่ แล้วไปเจอกันที่ทัวร์'];
const segmenter = new Intl.Segmenter(lang, { granularity: 'word' });
const taglineWords = TAGLINE.map((line) => {
  const words: string[] = [];
  for (const { segment, isWordLike } of segmenter.segment(line)) {
    if (!isWordLike && words.length) words[words.length - 1] += segment;
    else words.push(segment);
  }
  return words;
});

const faq = [
  {
    q: t('MyTrainerGym คืออะไร', 'What is MyTrainerGym?'),
    a: t(
      'สนามซ้อม Pokémon TCG ที่เล่นได้ในเบราว์เซอร์ จัดเด็คของคุณ ดวลกับบอทที่ใช้เด็คตัวท็อปใน meta (หัวหน้ายิม) แล้วรีวิวเกมกับโค้ชที่บอกว่าคุณพลาดเทิร์นไหน เล่นอีกทางจะได้อะไร และควรเผื่ออะไรไว้ ใช้ฟรี ไม่ต้องสมัคร',
      'A Pokémon TCG training gym in your browser: build a deck, battle bots playing the decks that rule the meta (the gym leaders), then review the game with a coach that shows which turns slipped, what the better way gets you and what to play around. Free, no sign-up.',
    ),
  },
  {
    q: t('ได้เข็มกลัดยิมยังไง', 'How do I earn gym badges?'),
    a: t(
      `หัวหน้ายิมมีทั้งหมด ${gyms.length} คน แต่ละคนคือเด็คตัวท็อปใน meta ชนะเด็คไหนก็ได้เข็มกลัดของเด็คนั้น ดูเข็มกลัดที่สะสมไว้ได้ที่หน้าประวัติเกม`,
      `There are ${gyms.length} gym leaders, the decks that rule the meta. Beat one and you earn its badge; your badge case is on the game history page.`,
    ),
  },
  {
    q: t('ต้องสมัครสมาชิกไหม', 'Do I need an account?'),
    a: t(
      'ไม่ต้อง เปิดเว็บแล้วเล่นได้เลย เกมที่เล่นจบและลิสต์ของคุณจะเก็บไว้ในเบราว์เซอร์เครื่องนี้',
      'No. Open the site and play. Your finished games and your lists are kept in this browser.',
    ),
  },
  {
    q: t('เด็คของบอทมาจากไหน', "Where do the bots' decks come from?"),
    a: t(
      `ลิสต์จริงจากทัวร์บน Limitless เราเลือกเด็คที่คนใช้มากที่สุดในช่วง ${limitless.days} วันล่าสุด จากทัวร์ที่มีผู้เล่นตั้งแต่ ${limitless.minPlayers} คนขึ้นไป (อัปเดต ${updated})`,
      `Real lists from tournaments on Limitless: the decks with the largest share in the last ${limitless.days} days, from tournaments with ${limitless.minPlayers} or more players. Updated ${updated}.`,
    ),
  },
  {
    q: t('บอทเล่นเก่งแค่ไหน', 'How well does the bot play?'),
    a: t(
      'บอทใช้ neural network ที่ฝึกจากการเล่นกับตัวเอง และคิดล่วงหน้าหลายทางก่อนตัดสินใจ บอทมองไม่เห็นการ์ดที่คุณซ่อนไว้ เดาได้จากการ์ดที่เปิดให้เห็นแล้วเท่านั้น ไม่มีโกง',
      "The bot uses a neural network trained by playing against itself, and looks ahead along several lines before it plays. It can't see your hidden cards: it only guesses from what has been revealed.",
    ),
  },
  {
    q: t('ใช้ลิสต์ของตัวเองได้ไหม', 'Can I use my own list?'),
    a: t(
      `ได้ จัดเด็คที่หน้าเด็คได้เลย ใช้งานเหมือนตัวจัดเด็คของ Limitless ค้นการ์ด กดเพื่อเพิ่ม กด − เพื่อเอาออก หรือวางลิสต์ที่ export มาก็ได้ ตอนนี้รองรับการ์ด ${SUPPORTED.length} ใบที่เด็คใน meta ใช้ ถ้ามีใบไหนที่ยังไม่รองรับ เว็บจะบอกให้รู้`,
      `Yes. Build it on the decks page the way you would in Limitless's deck builder: search for cards, click to add one, − to take one out, or paste an exported list. The ${SUPPORTED.length} cards the meta decks play are supported; if a card isn't yet, the site tells you which.`,
    ),
  },
  {
    q: t('เล่นบนมือถือได้ไหม', 'Can I play on my phone?'),
    a: t(
      'ได้ สนามปรับขนาดตามจอ แตะหรือลากการ์ดเพื่อเล่น กดค้างที่การ์ดเพื่ออ่านรายละเอียด',
      'Yes. The table fits the screen: drag or tap cards to play them, and press and hold a card to read it.',
    ),
  },
  {
    q: t('win% ในหน้ารีวิวคิดจากอะไร', 'How is the win% in a review worked out?'),
    a: t(
      'คิดจาก network ตัวเดียวกับบอทที่คุณเล่นด้วย โดยสุ่มการ์ดที่คุณมองไม่เห็นใหม่หลาย ๆ แบบแล้วหาค่าเฉลี่ย ตัวเลขนี้เป็นค่าประมาณ เอาไว้หาเทิร์นที่ควรกลับไปดูอีกรอบ',
      "By the same bot network you played against, averaged over many re-deals of the cards you couldn't see. It's an estimate, for finding the turns worth a second look.",
    ),
  },
];
---

<Base
  title={t('สนามซ้อม Pokémon TCG ออนไลน์ ฝึก matchup กับบอท AI', 'Pokémon TCG training gym: practise matchups against AI bots')}
  words={t('สนามซ้อม Pokémon TCG,จำลองเกมการ์ดโปเกมอน,ซ้อม matchup,บอท AI', 'Pokémon TCG training gym,Pokémon TCG simulator,matchup practice,AI bot').split(',')}
  jsonLd={[
    appLd(
      lang,
      siteUrl(Astro.site),
      t(
        'ซ้อม matchup Pokémon TCG กับบอท AI ที่ใช้ลิสต์เด็ค meta จริง จัดเด็คของคุณเอง แล้วรีวิวเกมด้วย win% ทุกเทิร์น',
        'Practise Pokémon TCG matchups against AI bots playing real meta decklists, build your own deck, and review every turn with win%.',
      ),
      siteUrl(Astro.site)(shot('board')),
    ),
    faqLd(faq),
  ]}
>
  <section class="hero">
    <ArenaLines class="hero-arena" frame />
    <p class="proof caption-4">
      {t('ข้อมูลจาก Limitless', 'Data from Limitless')} · <span class="mono">{num(limitless.tournaments)}</span> {t('ทัวร์นาเมนต์', 'tournaments')} ·
      <span class="mono">{num(limitless.players)}</span> {t('ผู้เล่น', 'players')} · {t('', 'last')} <span class="mono">{limitless.days}</span> {t('วันล่าสุด', 'days')}
    </p>
    <h1 class="heading-1">
      {t('ยิม Pokémon TCG ของคุณ', 'Your Pokémon TCG gym.')}<br />{t('ท้าดวลเด็คท็อปของ meta', 'Train against the meta.')}
    </h1>
    <p class="sub body-7">
      {t('เลือกเด็คที่ชอบหรือจัดเอง แล้วลงสนามกับบอทที่ใช้ลิสต์จริงจากทัวร์ล่าสุด', 'Pick your deck or build your own, then battle bots running real lists from recent tournaments,')}<br />
      {t('กฎ Standard เล่นในเบราว์เซอร์ได้เลย ไม่ต้องสมัคร', 'under Standard rules, in your browser, with no sign-up')}
    </p>
    <a class="btn primary" href={to('/play/')}>{t('เริ่มซ้อมกับบอท', 'Start training')}</a>
    <figure class="shot">
      <img
        src={shot('board')}
        alt={t(
          'หน้าจอเกม: สนามของคุณอยู่ด้านล่าง สนามของบอทอยู่ด้านบน มีการ์ดในมือ แถบคำสั่งใต้สนาม และช่องอ่านการ์ดกับบันทึกเกมทางขวา',
          "The game screen: your side below, the bot's above, your hand, the command bar under the table, and the card text and log on the right",
        )}
        width="1440"
        height="900"
        fetchpriority="high"
      />
    </figure>
  </section>

  <section class="section" aria-labelledby="meta-title">
    <header class="section-head reveal">
      <div>
        <p class="eyebrow">{t('หัวหน้ายิม', 'Gym leaders')}</p>
        <h2 id="meta-title" class="heading-3">{t('เด็คที่คุณต้องเอาชนะ', 'The decks you have to beat')}</h2>
        <p class="body-3 muted">
          {
            t(
              `${gyms.length} เด็คตัวท็อปของ meta บน Limitless ในช่วง ${limitless.days} วันล่าสุด (อัปเดต ${updated}) ชนะเด็คไหนก็ได้เข็มกลัดของเด็คนั้น`,
              `The ${gyms.length} decks that rule the meta on Limitless over the last ${limitless.days} days (updated ${updated}). Beat one to earn its badge.`,
            )
          }
        </p>
      </div>
      <a class="btn" href={to('/decks/')}>{t('ดูลิสต์ทั้งหมด', 'See every list')}</a>
    </header>
    <div class="decks reveal">
      {
        gyms.map((a, i) => (
          <DeckCard
            href={to(`/decks/${a.slugs[0]}/`)}
            name={a.name}
            rank={i + 1}
            share={a.metaShare}
            {maxShare}
            art={artOf(a.slugs[0]!)}
            badge={{ shape: a.shape, type: a.type }}
          />
        ))
      }
    </div>
  </section>

  <section class="section" aria-labelledby="how-title">
    <header class="section-head reveal">
      <div>
        <p class="eyebrow">{t('โปรแกรมซ้อม', 'Training plan')}</p>
        <h2 id="how-title" class="heading-3">{t('ซ้อมครบ จบในยิมเดียว', 'One full session, in one gym')}</h2>
      </div>
    </header>
    <ol class="steps">
      {
        steps.map((s, i) => (
          <li class="reveal" style={`--i:${i}`}>
            <span class="caption-3 step-no">
              <span class="mono">{String(i + 1).padStart(2, '0')}</span> · {s.phase}
            </span>
            <h3 class="title-1">{s.title}</h3>
            <p class="body-6 muted">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section after" aria-labelledby="after-title">
    <div class="after-text reveal">
      <p class="eyebrow">{t('โค้ชหลังเกม', 'Your coach')}</p>
      <h2 id="after-title" class="heading-3">{t('จบเกมปุ๊บ โค้ชชี้ให้เห็นว่าเกมพลิกที่เทิร์นไหน', 'After every battle, see the turn it turned on')}</h2>
      <p class="body-3 muted">
        {
          t(
            'วิเคราะห์ทุกเทิร์นของคุณในเบราว์เซอร์ มีกราฟ win% แยกตาคุณกับตาบอท เปิดเทิร์นที่ควรดูขึ้นมาบนสนาม เทียบทางที่คุณเล่นกับทางที่บอทจะเล่น บอกว่าเล่นแบบนั้นได้อะไร และเผื่อเทิร์นหน้าของอีกฝั่งไว้แค่ไหน',
            "Every turn of yours is analysed in your browser: a win% chart with your turns and the bot's apart, the turn worth a look on the table, your way next to the bot's, what that way gets you and what it plays around next turn.",
          )
        }
      </p>
      <a class="btn" href={to('/review/')}>{t('ดูประวัติเกม', 'Game history')}</a>
    </div>
    <figure class="shot after-shot reveal">
      <img
        src={shot('review')}
        alt={t(
          'หน้ารีวิวเกม: ประโยคสรุปเกม สนามในเทิร์นที่ควรดู กราฟ win% และทางที่คุณเล่นเทียบกับทางที่บอทจะเล่น',
          "A game's review: the summary sentence, the table at the turn worth a look, the win% chart, and your way next to the bot's",
        )}
        width="1216"
        height="760"
        loading="lazy"
      />
    </figure>
  </section>

  <section class="tagline-wrap" aria-label={t('สิ่งที่คุณได้', 'What you get')}>
    <p class="tagline heading-3">
      {
        taglineWords.map((line) => (
          <span class="tl">
            {line.map((w) => (
              <span class="w">{w}</span>
            ))}
          </span>
        ))
      }
    </p>
  </section>

  <section class="section faq" aria-labelledby="faq-title">
    <h2 id="faq-title" class="heading-3 reveal">{t('คำถามที่พบบ่อย', 'Questions')}</h2>
    <div class="qa reveal">
      {
        faq.map((f) => (
          <details>
            <summary class="title-2">
              {f.q}
              <span class="plus" aria-hidden="true" />
            </summary>
            <p class="body-3 muted">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="final reveal" aria-labelledby="final-title">
    <ArenaLines class="final-arena" />
    <ul class="badges" aria-label={t('เข็มกลัดยิมทั้งหมด', 'Every gym badge')}>
      {
        gyms.map((g) => (
          <li>
            <GymBadge shape={g.shape} type={g.type} size={40} label={g.name} />
          </li>
        ))
      }
    </ul>
    <h2 id="final-title" class="heading-4">{t('พร้อมท้าดวลยิมแรกหรือยัง', 'Ready for your first gym battle?')}</h2>
    <p class="body-3 muted">{t(`เลือกเด็ค เลือกหัวหน้ายิม แล้วเริ่มได้ทันที สะสมเข็มกลัดให้ครบ ${gyms.length} อัน`, `Pick a deck and a gym leader and start right away. Collect all ${gyms.length} badges.`)}</p>
    <a class="btn primary" href={to('/play/')}>{t('เริ่มซ้อมกับบอท', 'Start training')}</a>
  </section>
</Base>

<script>
  // The tagline lights up word by word as it scrolls through the screen (one listener, once per frame).
  const tagline = document.querySelector<HTMLElement>('.tagline');
  const words = tagline ? [...tagline.querySelectorAll<HTMLElement>('.w')] : [];
  if (tagline && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let queued = false;
    const update = () => {
      queued = false;
      const r = tagline.getBoundingClientRect();
      const start = innerHeight * 0.85;
      const end = innerHeight * 0.4;
      const p = (start - r.top) / (start - end + r.height);
      const lit = Math.round(Math.min(1, Math.max(0, p)) * words.length);
      words.forEach((w, i) => w.classList.toggle('on', i < lit));
    };
    addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(update);
      },
      { passive: true },
    );
    update();
  } else words.forEach((w) => w.classList.add('on'));
</script>

<style>
  .muted {
    color: var(--ink-soft);
  }
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 48px 0 0;
    text-align: center;
  }
  /* The gym's floor behind the headline: hairlines, the centre circle under the call to action. */
  .hero :global(.hero-arena) {
    position: absolute;
    z-index: -1;
    top: 0;
    left: 50%;
    width: min(1200px, 100vw);
    height: auto;
    transform: translateX(-50%);
    opacity: 0.55;
    animation: none;
  }
  .hero > * {
    animation: hero-in 0.7s var(--ease) both;
  }
  .hero > :nth-child(2) {
    animation-delay: 60ms;
  }
  .hero > :nth-child(3) {
    animation-delay: 120ms;
  }
  .hero > :nth-child(4) {
    animation-delay: 180ms;
  }
  .hero > :nth-child(5) {
    animation-delay: 300ms;
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
  }
  .proof {
    margin: 0 0 24px;
    padding: 4px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink-soft);
  }
  .proof {
    background: var(--paper);
  }
  .proof .mono {
    color: var(--brand);
  }
  h1 {
    max-width: 680px;
    margin: 0 0 24px;
    background: linear-gradient(90deg, #000000, #666666);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .sub {
    max-width: 680px;
    margin: 0 0 32px;
    color: var(--ink-soft);
  }
  /* The game itself, framed. */
  .shot {
    width: 100%;
    margin: 64px 0 0;
    padding: 8px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-xl);
    background: var(--card-bg);
  }
  .shot img {
