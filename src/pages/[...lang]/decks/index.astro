---
import DeckCard from '../../../components/DeckCard.astro';
import MyDecks from '../../../components/MyDecks.svelte';
import { formatDecklist } from '../../../data/decklist';
import { deckKeys } from '../../../engine/db';
import { langPaths, localePath, tFor } from '../../../i18n';
import Base from '../../../layouts/Base.astro';
import { gymLeaders, gymOf, headlines, loadDecks, metaDecks, sectionCount } from '../../../lib/decks';
import { breadcrumbLd, itemListLd, siteUrl } from '../../../lib/seo';

export function getStaticPaths() {
  return langPaths();
}

const t = tFor(Astro.props.lang);
const lang = Astro.props.lang;

const all = await loadDecks();
const decks = metaDecks(all);
const gyms = gymLeaders(all);
// For your own decks: the meta lists to start from, and their plans for lists near them.
const lists = decks.map((d) => ({
  slug: d.slug,
  name: d.meta.name,
  rank: d.meta.rank,
  metaShare: d.meta.metaShare,
  archetype: d.meta.limitless ?? d.slug,
  cards: deckKeys(d.lines.map((l) => l.entry)),
  text: formatDecklist(d.lines.map((l) => l.entry)),
}));
const maxShare = Math.max(...decks.map((d) => d.meta.metaShare ?? 0));
const url = siteUrl(Astro.site);
---

<Base
  title={t('เด็ค Pokémon TCG ใน meta และตัวจัดเด็ค', 'Pokémon TCG meta decks and deck builder')}
  description={t(
    'ลิสต์เด็ค Pokémon TCG ตัวท็อปของ meta จากทัวร์จริงบน Limitless พร้อมตัวจัดเด็คที่ใช้เหมือน Limitless ค้นการ์ด กดเพิ่ม จัดให้ครบ 60 ใบ แล้วเอาไปเล่นกับบอทได้เลย',
    "The Pokémon TCG decks that rule the meta, with real tournament lists from Limitless, and a deck builder that works like Limitless's: search, click to add, watch the count reach 60, then play the bot with it.",
  )}
  words={t('ลิสต์เด็ค,ตัวจัดเด็ค,deck builder,เด็คติดอันดับ', 'decklists,deck builder,top decks,meta decklists').split(',')}
  jsonLd={[
    breadcrumbLd(url, [
      { name: t('หน้าแรก', 'Home'), path: localePath(lang, '/') },
      { name: t('เด็คทั้งหมด', 'All decks'), path: localePath(lang, '/decks/') },
    ]),
    itemListLd(url, decks.map((d) => ({ name: d.meta.name, path: localePath(lang, `/decks/${d.slug}/`) }))),
  ]}
>
  <header class="page-head">
    <p class="eyebrow">{t('หัวหน้ายิม · เด็คใน meta', 'Gym leaders · meta decks')}</p>
    <h1 class="heading-3">{t('เด็คทั้งหมด', 'All decks')}</h1>
    <p class="body-7 lede">
      {
        t(
          'เด็คที่คนใช้มากที่สุดบน Limitless คือหัวหน้ายิมของที่นี่ ทุกเด็คใช้ลิสต์จริงจากทัวร์ล่าสุด ชนะเด็คไหนก็ได้เข็มกลัดของเด็คนั้น แตะเด็คเพื่อดูการ์ดทุกใบ หรือจัดเด็คของคุณเองได้ด้านล่าง',
          "The top decks of the meta by their share on Limitless are this gym's leaders, each playing a real list from a recent tournament. Beat one to earn its badge. Pick one to see every card, or build your own deck below.",
        )
      }
    </p>
  </header>

  <div class="grid reveal">
    {
      decks.map((d) => (
        <DeckCard
          href={localePath(lang, `/decks/${d.slug}/`)}
          name={d.meta.name}
          rank={d.meta.rank}
          share={d.meta.metaShare}
          {maxShare}
          art={headlines(d)[0]?.print.image.high}
          note={d.meta.listSource}
          counts={`Pokémon ${sectionCount(d, 'pokemon')} · Trainer ${sectionCount(d, 'trainer')} · Energy ${sectionCount(d, 'energy')}`}
          badge={gymOf(gyms, d.slug)}
        />
      ))
    }
  </div>

  <MyDecks client:only="svelte" decks={lists} />
</Base>

<style>
  .page-head {
    max-width: 680px;
    margin-bottom: 40px;
  }
  h1 {
    margin: 0 0 12px;
  }
  .lede {
    margin: 0;
    color: var(--ink-soft);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }
  }
</style>
