---
import DeckCard from '../../../components/DeckCard.astro';
import MyDecks from '../../../components/MyDecks.svelte';
import { formatDecklist } from '../../../data/decklist';
import { deckKeys } from '../../../engine/db';
import { langPaths, localePath, tFor } from '../../../i18n';
import Base from '../../../layouts/Base.astro';
import { headlines, loadDecks, metaDecks, sectionCount } from '../../../lib/decks';

export function getStaticPaths() {
  return langPaths();
}

const t = tFor(Astro.props.lang);
const lang = Astro.props.lang;

const decks = metaDecks(await loadDecks());
// For your own decks: the meta lists to start from, and their plans for lists near them.
const lists = decks.map((d) => ({
  slug: d.slug,
  name: d.meta.name,
  rank: d.meta.rank,
  metaShare: d.meta.metaShare,
  archetype: d.meta.limitless ?? d.slug,
  cards: deckKeys(d.lines.map((l) => l.entry)),
  text: formatDecklist(d.lines.map((l) => l.entry)),
}));
const maxShare = Math.max(...decks.map((d) => d.meta.metaShare ?? 0));
---

<Base title={t('เด็คทั้งหมด', 'All decks')}>
  <header class="page-head">
    <p class="eyebrow">{t('เด็คใน meta', 'Meta decks')}</p>
    <h1 class="heading-3">{t('เด็คทั้งหมด', 'All decks')}</h1>
    <p class="body-7 lede">
      {
        t(
          'เด็คอันดับต้นของ meta ตามสัดส่วนบน Limitless แต่ละเด็คใช้ list จริงจากทัวร์นาเมนต์ล่าสุด เลือกเด็คเพื่อดูการ์ดทุกใบ หรือเพิ่ม list ของคุณเองด้านล่าง',
          "The top decks of the meta by their share on Limitless, each playing a real list from a recent tournament. Pick one to see every card, or add your own list below.",
        )
      }
    </p>
  </header>

  <div class="grid reveal">
    {
      decks.map((d) => (
        <DeckCard
          href={localePath(lang, `/decks/${d.slug}/`)}
          name={d.meta.name}
          rank={d.meta.rank}
          share={d.meta.metaShare}
          {maxShare}
          art={headlines(d)[0]?.print.image.high}
          note={d.meta.listSource}
          counts={`Pokémon ${sectionCount(d, 'pokemon')} · Trainer ${sectionCount(d, 'trainer')} · Energy ${sectionCount(d, 'energy')}`}
        />
      ))
    }
  </div>

  <MyDecks client:only="svelte" decks={lists} />
</Base>

<style>
  .page-head {
    max-width: 680px;
    margin-bottom: 40px;
  }
  h1 {
    margin: 0 0 12px;
  }
  .lede {
    margin: 0;
    color: var(--ink-soft);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }
  }
</style>
