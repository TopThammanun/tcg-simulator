---
import type { GetStaticPaths } from 'astro';
import CardText from '../../components/CardText.astro';
import CardTile from '../../components/CardTile.astro';
import type { DeckSection } from '../../data/decklist';
import Base from '../../layouts/Base.astro';
import { loadDecks, metaDecks, SECTION_LABEL, sectionCount, type DeckView } from '../../lib/decks';

export const getStaticPaths = (async () => {
  const decks = metaDecks(await loadDecks());
  return decks.map((deck) => ({ params: { slug: deck.slug }, props: { deck } }));
}) satisfies GetStaticPaths;

const { deck } = Astro.props as { deck: DeckView };
const sections: DeckSection[] = ['pokemon', 'trainer', 'energy'];
let tileIndex = 0;
---

<Base title={deck.meta.name}>
  <a class="back" href="/decks/">← เด็คทั้งหมด</a>
  <header class="deck-head">
    <p class="eyebrow">อันดับ {deck.meta.rank} · <span class="mono">{deck.meta.metaShare?.toFixed(1)}%</span> ของ meta</p>
    <h1 class="heading-3">{deck.meta.name}</h1>
    <p class="source body-6">
      {deck.meta.listSource}
      {deck.meta.listUrl && <a href={deck.meta.listUrl} rel="noopener">list บน Limitless ↗</a>}
    </p>
    <p class="play">
      <a class="btn primary" href={`/play/?me=${deck.slug}`}>เล่นด้วยเด็คนี้</a>
      <a class="btn" href={`/play/?opp=${deck.slug}`}>ซ้อมกับเด็คนี้</a>
    </p>
  </header>

  <div class="layout">
    <aside class="sheet" aria-label="decklist">
      {
        sections.map((s) => (
          <section>
            <h2>
              {SECTION_LABEL[s]} <span class="mono">{sectionCount(deck, s)}</span>
            </h2>
            <ul>
              {deck.lines
                .filter((l) => l.entry.section === s)
                .map((l) => (
                  <li>
                    <button type="button" data-detail={l.print.key}>
                      <span class="mono qty">{l.entry.count}</span>
                      <span class="cname">{l.entry.name}</span>
                      <span class="mono setno">
                        {l.entry.set} {l.entry.number}
                      </span>
                    </button>
                  </li>
                ))}
            </ul>
          </section>
        ))
      }
      <p class="total mono">รวม {deck.lines.reduce((n, l) => n + l.entry.count, 0)} ใบ</p>
    </aside>

    <div class="cards">
      {
        sections.map((s) => (
          <section>
            <h2 class="section-title">{SECTION_LABEL[s]}</h2>
            <div class="grid">
              {deck.lines
                .filter((l) => l.entry.section === s)
                .map((l) => (
                  <CardTile print={l.print} card={l.card} count={l.entry.count} index={tileIndex++} />
                ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>

  <dialog id="card-dialog" aria-label="รายละเอียดการ์ด">
    <form method="dialog"><button class="close" aria-label="ปิด">×</button></form>
    <div class="dialog-body"></div>
  </dialog>

  {
    deck.lines.map((l) => (
      <template id={`detail-${l.print.key}`}>
        <div class="detail">
          {l.print.image.high && (
            <img
              src={l.print.image.high}
              alt={l.card.name}
              width="600"
              height="825"
              onerror="this.remove()"
            />
          )}
          <div class="detail-text">
            <CardText card={l.card} />
          </div>
        </div>
      </template>
    ))
  }
</Base>

<script>
  const dialog = document.getElementById('card-dialog') as HTMLDialogElement;
  const body = dialog.querySelector('.dialog-body')!;

  document.addEventListener('click', (e) => {
    const trigger = (e.target as Element).closest<HTMLElement>('[data-detail]');
    if (!trigger) return;
    const tpl = document.getElementById(`detail-${trigger.dataset.detail}`) as HTMLTemplateElement | null;
    if (!tpl) return;
    body.replaceChildren(tpl.content.cloneNode(true));
    dialog.showModal();
  });

  // Click on the backdrop closes the dialog.
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>

<style>
  .back {
    display: inline-block;
    margin-bottom: 24px;
    color: var(--ink-soft);
    font-size: 14px;
    line-height: 20px;
    text-decoration: none;
    transition: color 0.3s var(--ease);
  }
  .back:hover {
    color: var(--ink-strong);
  }
  .deck-head {
    max-width: 760px;
    margin-bottom: 48px;
  }
  h1 {
    margin: 0 0 8px;
  }
  .source {
    margin: 0;
    color: var(--ink-soft);
  }
  .source a {
    margin-left: 8px;
    color: var(--ink-strong);
    text-underline-offset: 4px;
  }
  .play {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 24px 0 0;
  }
  .layout {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 40px;
    align-items: start;
  }
  .sheet {
    position: sticky;
    top: 80px;
    padding: 16px;
    background: var(--card-bg);
    border: 1px solid var(--rule);
    border-radius: var(--radius-xl);
  }
  .sheet h2 {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin: 24px 0 8px;
    color: var(--ink-soft);
    font-size: 12px;
    line-height: 16px;
    font-weight: 500;
  }
  .sheet h2 .mono {
    color: var(--ink-strong);
  }
  .sheet section:first-child h2 {
    margin-top: 0;
  }
  .sheet ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sheet button {
    display: grid;
    grid-template-columns: 24px 1fr auto;
    gap: 8px;
    width: 100%;
    padding: 4px 8px;
    border: 0;
    border-radius: 6px;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: 14px;
    line-height: 20px;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.3s var(--ease);
  }
  .sheet button:hover {
    background: var(--control);
  }
  .qty {
    color: var(--ink-strong);
    font-weight: 500;
  }
  .cname {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .setno {
    color: var(--ink-faint);
    font-size: 12px;
  }
  .total {
    margin: 16px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--rule);
    color: var(--ink-soft);
    font-size: 12px;
    line-height: 16px;
    text-align: right;
  }
  .section-title {
    margin: 0 0 16px;
    font-size: 20px;
    line-height: 28px;
  }
  .cards section + section {
    margin-top: 40px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(136px, 1fr));
    gap: 24px 16px;
  }

  dialog {
    width: min(860px, calc(100% - 32px));
    max-height: calc(100% - 32px);
    padding: 32px;
    border: 1px solid var(--line);
    background: var(--card-bg);
    color: var(--ink);
    box-shadow: var(--shadow-lg);
    border-radius: var(--radius-xl);
  }
  dialog::backdrop {
    background: #000000b3;
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }
  .close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: var(--radius);
    background: none;
    color: var(--ink-soft);
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }
  .close:hover {
    background: var(--control);
    color: var(--ink-strong);
  }
  .dialog-body :global(.detail) {
    display: grid;
    grid-template-columns: minmax(0, 300px) 1fr;
    gap: 32px;
    align-items: start;
  }
  .dialog-body :global(.detail img) {
    width: 100%;
    height: auto;
    border-radius: 4.5% / 3.2%;
  }
  .dialog-body :global(.detail-text) {
    font-size: 18px;
    /* keep the name/HP line clear of the close button */
    padding-right: 32px;
  }

  @media (max-width: 760px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .sheet {
      position: static;
    }
    .grid {
      grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
      gap: 16px 12px;
    }
    dialog {
      padding: 24px 16px;
    }
    .dialog-body :global(.detail) {
      grid-template-columns: 1fr;
    }
    .dialog-body :global(.detail img) {
      max-width: 260px;
      margin: 0 auto;
    }
  }
</style>
