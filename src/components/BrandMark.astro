---
// MyTrainerGym's mark: a trainer's ball drawn as a gym badge (our own drawing, not the Poké Ball): a hexagon, red
// above and white below a dark band, a hexagonal button in the middle. The same shape is the favicon
// (public/favicon.svg) and the emblem on the play mat's centre line (Board.svelte).
interface Props {
  size?: number;
}
const { size = 20 } = Astro.props;
---

<svg class="brand-mark" viewBox="0 0 32 32" width={size} height={size} aria-hidden="true">
  <path d="M2 16L9 3.88H23L30 16Z" fill="var(--brand)" />
  <path d="M2 16L9 28.12H23L30 16Z" fill="#ffffff" />
  <path d="M2 16H30" stroke="var(--mark-ink)" stroke-width="3" />
  <path d="M30 16L23 28.12H9L2 16L9 3.88H23Z" fill="none" stroke="var(--mark-ink)" stroke-width="2" stroke-linejoin="round" />
  <path d="M21.2 16L18.6 20.5H13.4L10.8 16L13.4 11.5H18.6Z" fill="var(--mark-ink)" />
  <path d="M18.6 16L17.3 18.25H14.7L13.4 16L14.7 13.75H17.3Z" fill="#ffffff" />
</svg>
