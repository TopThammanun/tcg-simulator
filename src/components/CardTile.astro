---
// One decklist line as a card: low-res image, or the text frame when there is no image
// or it fails to load (offline, blocked). Click opens the detail dialog (see decks/[slug]).
import type { CardDef, CardPrint } from '../data/cards';
import CardText from './CardText.astro';

interface Props {
  print: CardPrint;
  card: CardDef;
  count: number;
  index?: number;
}
const { print, card, count, index = 0 } = Astro.props;
const src = print.image.source === 'none' ? undefined : print.image.low;
const note = !src ? 'ไม่มีรูป' : print.image.altOf ? 'รูปจาก print อื่น' : undefined;
---

<button
  type="button"
  class="tile rise"
  style={`--i:${index}`}
  data-detail={print.key}
  data-broken={src ? undefined : ''}
  aria-label={`${count} ใบ ${card.name} — ดูรายละเอียด`}
>
  {
    src && (
      <img
        src={src}
        alt={card.name}
        width="245"
        height="342"
        loading="lazy"
        decoding="async"
        onerror="this.closest('.tile').dataset.broken = ''"
      />
    )
  }
  <div class="frame"><CardText card={card} compact /></div>
  <span class="count mono">×{count}</span>
  {note && <span class="note">{note}</span>}
</button>

<style>
  .tile {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 63 / 88;
    padding: 0;
    border: 0;
    border-radius: 4.5% / 3.2%;
    background: var(--card-bg);
    box-shadow: var(--shadow);
    cursor: zoom-in;
    font: inherit;
    color: inherit;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }
  .tile:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }
  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
  }
  .frame {
    display: none;
    position: absolute;
    inset: 0;
    padding: 9% 8%;
    overflow: hidden;
    border-radius: inherit;
    border: 2px solid var(--line);
    background:
      repeating-linear-gradient(-45deg, transparent 0 6px, color-mix(in srgb, var(--rule) 35%, transparent) 6px 7px),
      var(--card-bg);
  }
  .tile[data-broken] img {
    display: none;
  }
  .tile[data-broken] .frame {
    display: block;
  }
  .count {
    position: absolute;
    top: -6px;
    left: -6px;
    min-width: 2.1em;
    padding: 1px 6px;
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
    font-size: 0.8rem;
    text-align: center;
    border-radius: 2px;
  }
  .note {
    position: absolute;
    right: 6px;
    bottom: 6px;
    padding: 1px 6px;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    border: 1px solid var(--stamp);
    color: var(--stamp);
    font-size: 0.68rem;
  }
</style>
