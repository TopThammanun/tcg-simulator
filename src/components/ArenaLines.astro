---
// A gym's battle floor seen from above, as hairlines: the court, its centre line and circle, a trainer's box at
// each end. Decoration only, drawn in the line colour. `frame`: the court without its centre circle, the centre line
// only from under the call to action down (the home page's hero, where text sits in the middle).
interface Props {
  class?: string;
  frame?: boolean;
}
const { class: cls, frame = false } = Astro.props;
---

<svg class:list={['arena-lines', cls]} viewBox="0 0 1200 560" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
  <rect x="12" y="12" width="1176" height="536" rx="24" />
  {
    frame ? (
      <path d="M600 430V548" />
    ) : (
      <>
        <path d="M600 12V548" />
        <circle cx="600" cy="280" r="96" />
        <circle cx="600" cy="280" r="6" class="dot" />
      </>
    )
  }
  <rect x="12" y="160" width="132" height="240" rx="12" />
  <rect x="1056" y="160" width="132" height="240" rx="12" />
  <path d="M144 280H196M1004 280H1056" />
</svg>

<style>
  .arena-lines {
    display: block;
    fill: none;
    stroke: var(--line);
    stroke-width: 1.5;
  }
  .arena-lines * {
    vector-effect: non-scaling-stroke;
  }
  .dot {
    fill: var(--brand);
    stroke: none;
  }
</style>
