---
// Card text writes Energy as {G}, {P}…; render those as the Energy symbols printed on the cards.
import { energyIcon, energyParts } from '../ui/symbols';

interface Props {
  text: string;
}
const { text } = Astro.props;
---

{
  energyParts(text).map((p) =>
    'type' in p ? <span class="pip" role="img" aria-label={p.type} title={p.type} style={`background-image:url(${energyIcon(p.type)})`} /> : p.text,
  )
}

<style>
  .pip {
    display: inline-block;
    width: 1.2em;
    height: 1.2em;
    border-radius: 50%;
    background: center / cover no-repeat;
    box-shadow: 0 0 0 1px #0008;
    vertical-align: -0.22em;
  }
</style>
