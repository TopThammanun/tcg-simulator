---
// Card text writes Energy as {G}, {P}…; render those as coloured pips.
interface Props {
  text: string;
}
const { text } = Astro.props;

const TYPE_BY_SYMBOL: Record<string, string> = {
  G: 'grass', R: 'fire', W: 'water', L: 'lightning', P: 'psychic', F: 'fighting',
  D: 'darkness', M: 'metal', N: 'dragon', Y: 'fairy', C: 'colorless',
};
const parts = text.split(/(\{[A-Z]\})/).filter(Boolean);
---

{
  parts.map((p) => {
    const type = /^\{[A-Z]\}$/.test(p) ? TYPE_BY_SYMBOL[p[1]!] : undefined;
    return type ? (
      <span class="pip" style={`--c:var(--t-${type})`} title={type}>
        {p[1]}
      </span>
    ) : (
      p
    );
  })
}

<style>
  .pip {
    display: inline-grid;
    place-items: center;
    width: 1.35em;
    height: 1.35em;
    border-radius: 50%;
    background: var(--c);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.72em;
    font-weight: 600;
    box-shadow: inset 0 -1px 0 #0003;
    vertical-align: middle;
  }
</style>
