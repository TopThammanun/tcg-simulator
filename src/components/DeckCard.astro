---
// One meta deck as a Gym Leader's card: its headline Pokémon's art (cropped from the card image) with the gym's badge,
// rank, name, meta share.
import { langOfPath, tFor } from '../i18n';
import GymBadge from './GymBadge.svelte';

interface Props {
  href: string;
  name: string;
  rank?: number;
  /** Meta share in percent, and the largest share on the page (for the bar). */
  share?: number;
  maxShare?: number;
  /** The card image the art is cropped from. */
  art?: string;
  note?: string;
  counts?: string;
  /** The Gym Leader's badge (lib/decks.ts gymLeaders). */
  badge?: { shape: number; type: string };
}
const { href, name, rank, share, maxShare = 100, art, note, counts, badge } = Astro.props;
const t = tFor(langOfPath(Astro.url.pathname));
---

<a class="deck-card" href={href}>
  <span class="art" aria-hidden="true">
    {art && <img src={art} alt="" loading="lazy" decoding="async" width="600" height="825" />}
    {
      badge && (
        <span class="badge">
          <GymBadge shape={badge.shape} type={badge.type} size={36} />
        </span>
      )
    }
  </span>
  <span class="body">
    <span class="top">
      {rank !== undefined && <span class="caption-4 rank">{t('อันดับ', 'Rank')} {rank}</span>}
      {share !== undefined && <span class="mono caption-4 pct">{share.toFixed(1)}%</span>}
    </span>
    <span class="name title-2">{name}</span>
    {note && <span class="caption-5 note">{note}</span>}
    {counts && <span class="caption-5 counts">{counts}</span>}
    {
      share !== undefined && (
        <span class="bar">
          <span style={`width:${(share / maxShare) * 100}%`} />
        </span>
      )
    }
  </span>
</a>

<style>
  .deck-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: var(--radius-xl);
    background: var(--card-bg);
    text-decoration: none;
    transition:
      border-color 0.3s var(--ease),
      transform 0.5s var(--ease);
  }
  .deck-card:hover {
    border-color: color-mix(in srgb, var(--brand) 55%, transparent);
    transform: translateY(-4px);
  }
  .deck-card:active {
    transform: translateY(-2px) scale(0.99);
  }
  /* The art window of the card: the frame and the text are cut away. */
  .art {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--raised);
  }
  .art img {
    position: absolute;
    left: -11%;
    top: -35%;
    width: 122%;
    height: auto;
    transition: transform 0.5s var(--ease);
  }
  .deck-card:hover .art img {
    transform: scale(1.04);
  }
  /* The gym's badge, pinned to the art's corner. */
  .badge {
    position: absolute;
    left: 12px;
    bottom: 12px;
    padding: 4px;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--raised) 92%, transparent);
    box-shadow: var(--shadow);
    transition: transform 0.5s var(--ease);
  }
  .deck-card:hover .badge {
    transform: rotate(-8deg) scale(1.08);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px;
  }
  .top {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    color: var(--ink-soft);
  }
  .pct {
    color: var(--ink-strong);
  }
  .name {
    color: var(--ink-strong);
  }
  .counts {
    font-variant-numeric: tabular-nums;
  }
  .note,
  .counts {
    color: var(--ink-soft);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .bar {
    display: block;
    height: 4px;
    margin-top: 8px;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--control);
  }
  .bar span {
    display: block;
    height: 100%;
    background: var(--brand);
  }
  @media (max-width: 640px) {
    .deck-card {
      border-radius: var(--radius-lg);
    }
    .body {
      padding: 12px;
    }
    .name {
      font-size: 16px;
      line-height: 24px;
    }
    .badge {
      left: 8px;
      bottom: 8px;
    }
  }
</style>
