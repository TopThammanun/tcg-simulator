---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'ซ้อม matchup Pokémon TCG กับบอทที่เล่นเด็คใน meta ในเบราว์เซอร์' } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'หน้าแรก' },
  { href: '/play/', label: 'เล่น' },
  { href: '/decks/', label: 'เด็ค' },
  { href: '/review/', label: 'ประวัติเกม' },
];
const current = (href: string) => path === href || (href !== '/' && path.startsWith(href));
const ISSUES = 'https://github.com/TopThammanun/tcg-simulator/issues';
const fullTitle = `${title} · สนามซ้อม Matchup`;
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- The card pictures' hosts (data/cards.manifest.json, src/ui/card-back.ts): connected before the first picture. -->
    <link rel="preconnect" href="https://assets.tcgdex.net" />
    <link rel="preconnect" href="https://images.pokemontcg.io" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&family=Noto+Sans+Thai:wght@400;500;600;700&display=swap"
    />
    <title>{fullTitle}</title>
    <!-- Reveal animations only when scripts run, so the page never stays hidden. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">ข้ามไปเนื้อหา</a>
    <header class="nav-wrap">
      <nav class="nav" aria-label="เมนูหลัก">
        <a class="brand" href="/">
          <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
            <rect x="4" y="4" width="14" height="20" rx="3" fill="currentColor" opacity="0.35" />
            <rect x="12" y="8" width="14" height="20" rx="3" fill="currentColor" />
          </svg>
          สนามซ้อม Matchup
        </a>
        <div class="links" id="nav-links">
          {
            nav.map((n, i) => (
              <a href={n.href} style={`--i:${i}`} aria-current={current(n.href) ? 'page' : undefined}>
                {n.label}
              </a>
            ))
          }
        </div>
        <button type="button" class="toggle" aria-expanded="false" aria-controls="nav-links" aria-label="เปิดเมนู">
          <span></span><span></span>
        </button>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="footer-inner">
        <div>
          <a class="brand" href="/">
            <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
              <rect x="4" y="4" width="14" height="20" rx="3" fill="currentColor" opacity="0.35" />
              <rect x="12" y="8" width="14" height="20" rx="3" fill="currentColor" />
            </svg>
            สนามซ้อม Matchup
          </a>
          <p class="caption-5 legal">
            เว็บแฟนเมด ไม่หากำไร ไม่เกี่ยวข้องกับ The Pokémon Company, Nintendo, Creatures หรือ GAME FREAK
            รูปและข้อความการ์ดเป็นของเจ้าของลิขสิทธิ์ ดึงจาก TCGdex และ pokemontcg.io
          </p>
        </div>
        <nav class="footer-links" aria-label="ลิงก์ท้ายเว็บ">
          {nav.slice(1).map((n) => <a href={n.href}>{n.label}</a>)}
          <a href={ISSUES} rel="noopener">แจ้งปัญหา</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<script>
  // Phones: the menu opens as a full height panel; the toggle's two lines turn into a cross.
  const toggle = document.querySelector<HTMLButtonElement>('.nav .toggle');
  const root = document.documentElement;
  const setOpen = (open: boolean) => {
    root.classList.toggle('menu-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'ปิดเมนู' : 'เปิดเมนู');
  };
  toggle?.addEventListener('click', () => setOpen(!root.classList.contains('menu-open')));
  document.querySelectorAll('#nav-links a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  matchMedia('(min-width: 641px)').addEventListener('change', () => setOpen(false));

  // Sections marked .reveal rise into place once, when they enter the screen.
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        e.target.classList.add('in');
        io.unobserve(e.target);
      }
    },
    { rootMargin: '0px 0px -10% 0px' },
  );
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
</script>

<style is:global>
  /* One dark, flat theme: black page, #181818 / #1F1F1F surfaces, hairline borders. Card art brings the colour;
     white is the main action, amber marks what can be played or picked, red is for danger and the opponent.
     One type family: Geist for Latin and figures, Noto Sans Thai for Thai (the browser picks per glyph). */
  :root {
    --paper: #000000;
    --paper-deep: #1f1f1f;
    --card-bg: #181818;
    --raised: #1f1f1f;
    --control: #272727;
    --ink: #ededed;
    --ink-strong: #ffffff;
    --ink-soft: #9b9b9b;
    --ink-faint: #6e6e6e;
    --rule: #272727;
    --line: #313131;
    --stamp: #e5484d;
    --teal: #4cc38a;
    --primary: #ffffff;
    --primary-ink: #000000;
    --press: #d4d4d4;
    --accent: #f0b429;
    --accent-ink: #1a1300;
    --radius: 8px;
    --radius-lg: 12px;
    --radius-xl: 16px;
    --shadow: 0 1px 2px #0009;
    --shadow-lg: 0 24px 48px -16px #000;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --font-body: 'Geist', 'Noto Sans Thai', 'Leelawadee UI', sans-serif;
    --font-heading: var(--font-body);
    --font-display: var(--font-body);
    --font-mono: 'Geist Mono', 'Noto Sans Thai', ui-monospace, monospace;

    --t-grass: #3f8a3a;
    --t-fire: #d24e2b;
    --t-water: #2b7bbd;
    --t-lightning: #e3b11f;
    --t-psychic: #94509a;
    --t-fighting: #b0612c;
    --t-darkness: #2e3a3c;
    --t-metal: #858d93;
    --t-dragon: #a9842b;
    --t-fairy: #d27aab;
    --t-colorless: #c9c3b3;
    color-scheme: dark;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 24px;
    -webkit-font-smoothing: antialiased;
  }

  main {
    flex: 1;
    width: min(1200px, 100%);
    margin: 0 auto;
    padding: 48px 16px 96px;
  }

  h1,
  h2,
  h3,
  h4 {
    color: var(--ink-strong);
    font-weight: 600;
    text-wrap: balance;
  }

  p {
    text-wrap: pretty;
  }

  a {
    color: inherit;
  }

  ::selection {
    background: #ffffff33;
  }

  :focus-visible {
    outline: 2px solid var(--ink-strong);
    outline-offset: 2px;
  }

  /* Text styles (one scale; Thai needs more room above and below the line than Latin, so headings get 1.25). */
  .heading-1 {
    font-size: 60px;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .heading-3 {
    font-size: 36px;
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .heading-4 {
    font-size: 30px;
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .heading-5 {
    font-size: 24px;
    line-height: 32px;
    font-weight: 600;
  }
  .heading-6 {
    font-size: 20px;
    line-height: 28px;
    font-weight: 600;
  }
  .title-1 {
    font-size: 20px;
    line-height: 28px;
    font-weight: 500;
  }
  .title-2 {
    font-size: 18px;
    line-height: 28px;
    font-weight: 500;
  }
  .title-3 {
    font-size: 16px;
    line-height: 24px;
    font-weight: 500;
  }
  .title-4 {
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
  }
  .body-3 {
    font-size: 16px;
    line-height: 24px;
    font-weight: 400;
  }
  .body-6 {
    font-size: 14px;
    line-height: 20px;
    font-weight: 400;
  }
  .body-7 {
    font-size: 18px;
    line-height: 28px;
    font-weight: 400;
  }
  .caption-3 {
    font-size: 12px;
    line-height: 16px;
    font-weight: 600;
  }
  .caption-4 {
    font-size: 12px;
    line-height: 16px;
    font-weight: 500;
  }
  .caption-5 {
    font-size: 12px;
    line-height: 16px;
    font-weight: 400;
  }
  @media (max-width: 640px) {
    .heading-1 {
      font-size: 30px;
    }
    .heading-3 {
      font-size: 30px;
    }
    .heading-4 {
      font-size: 24px;
    }
  }

  /* Buttons: white for the one main action, dark for the rest. */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--control);
    color: var(--ink-strong);
    font: inherit;
    font-size: 16px;
    line-height: 24px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 0.3s var(--ease),
      border-color 0.3s var(--ease),
      transform 0.3s var(--ease);
  }
  .btn:hover {
    background: #313131;
  }
  .btn:active {
    transform: scale(0.98);
  }
  .btn.primary {
    border-color: var(--primary);
    background: var(--primary);
    color: var(--primary-ink);
  }
  .btn.primary:hover {
    border-color: var(--press);
    background: var(--press);
  }
  .btn.sm {
    padding: 4px 12px;
    font-size: 14px;
    line-height: 20px;
  }

  .skip {
    position: absolute;
    left: 16px;
    top: -48px;
    z-index: 60;
    padding: 8px 12px;
    border-radius: var(--radius);
    background: var(--primary);
    color: var(--primary-ink);
    font-weight: 600;
  }
  .skip:focus {
    top: 16px;
  }

  /* The header: a compact bar floating off the top, centred, over a blur. */
  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 25;
    display: flex;
    justify-content: center;
    padding: 12px 16px 0;
    pointer-events: none;
  }
  /* The blur sits on a layer behind the bar: on the bar itself it would make the bar the box that the phone
     menu (position: fixed) fills, instead of the screen. */
  .nav {
    position: relative;
    z-index: 0;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    pointer-events: auto;
  }
  .nav::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: #181818b8;
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    backdrop-filter: blur(16px) saturate(140%);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px 4px 8px;
    color: var(--ink-strong);
    font-size: 14px;
    line-height: 20px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .brand-mark {
    width: 20px;
    height: 20px;
    flex: none;
  }
  .links {
    display: flex;
    gap: 4px;
  }
  .links a {
    padding: 4px 12px;
    border-radius: var(--radius);
    color: var(--ink-soft);
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.3s var(--ease),
      background-color 0.3s var(--ease);
  }
  .links a:hover {
    color: var(--ink-strong);
  }
  .links a[aria-current='page'] {
    background: var(--control);
    color: var(--ink-strong);
  }
  .toggle {
    display: none;
    position: relative;
    width: 32px;
    height: 28px;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: none;
    cursor: pointer;
  }
  .toggle span {
    position: absolute;
    left: 8px;
    width: 16px;
    height: 2px;
    border-radius: 1px;
    background: var(--ink-strong);
    transition: transform 0.5s var(--ease);
  }
  .toggle span:first-child {
    transform: translateY(-3px);
  }
  .toggle span:last-child {
    transform: translateY(3px);
  }
  .menu-open .toggle span:first-child {
    transform: rotate(45deg);
  }
  .menu-open .toggle span:last-child {
    transform: rotate(-45deg);
  }
  @media (max-width: 640px) {
    .nav {
      width: 100%;
      justify-content: space-between;
    }
    .toggle {
      display: block;
      z-index: 2;
    }
    .links {
      position: fixed;
      inset: 0;
      z-index: 1;
      flex-direction: column;
      gap: 8px;
      padding: 96px 24px 32px;
      background: #000000eb;
      -webkit-backdrop-filter: blur(24px);
      backdrop-filter: blur(24px);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.3s var(--ease),
        visibility 0s linear 0.3s;
    }
    .menu-open .links {
      opacity: 1;
      visibility: visible;
      transition: opacity 0.3s var(--ease);
    }
    .links a {
      padding: 12px 16px;
      font-size: 24px;
      line-height: 32px;
      font-weight: 600;
    }
    .menu-open .links a {
      animation: menu-in 0.5s var(--ease) both;
      animation-delay: calc(var(--i) * 60ms);
    }
    .menu-open,
    .menu-open body {
      overflow: hidden;
    }
    main {
      padding-top: 32px;
    }
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  .footer {
    border-top: 1px solid var(--rule);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 24px 48px;
    width: min(1200px, 100%);
    margin: 0 auto;
    padding: 40px 16px 48px;
  }
  .footer .brand {
    padding-left: 0;
  }
  .legal {
    max-width: 560px;
    margin: 8px 0 0;
    color: var(--ink-soft);
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    align-content: flex-start;
  }
  .footer-links a {
    color: var(--ink-soft);
    font-size: 14px;
    line-height: 20px;
    text-decoration: none;
    transition: color 0.3s var(--ease);
  }
  .footer-links a:hover {
    color: var(--ink-strong);
  }

  .mono {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  /* A small label over a heading. */
  .eyebrow {
    display: block;
    margin: 0 0 8px;
    color: var(--ink-soft);
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
  }

  /* Entrances: decelerate into place; plain fades when motion is reduced. */
  .js .reveal {
    opacity: 0;
    transform: translateY(32px);
    transition:
      opacity 0.7s var(--ease),
      transform 0.7s var(--ease);
  }
  .js .reveal.in {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .rise {
      animation: rise 0.5s var(--ease) both;
      animation-delay: calc(var(--i, 0) * 30ms);
    }
    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .js .reveal {
      transform: none;
      transition: opacity 0.3s linear;
    }
  }
</style>
