---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'ซ้อม matchup Pokémon TCG กับบอทที่เล่นเด็คใน meta ในเบราว์เซอร์' } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'หน้าแรก' },
  { href: '/play/', label: 'เล่น' },
  { href: '/decks/', label: 'เด็ค' },
  { href: '/review/', label: 'ประวัติเกม' },
];
const ISSUES = 'https://github.com/TopThammanun/tcg-simulator/issues';
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans+Thai:wght@400;500;600;700&family=Noto+Serif+Thai:wght@500;600;700&display=swap"
    />
    <title>{title} · สนามซ้อม Matchup</title>
  </head>
  <body>
    <header class="masthead">
      <a class="brand" href="/">
        <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
          <rect x="3" y="4" width="15" height="21" rx="2" fill="currentColor" />
          <rect x="13" y="7" width="15" height="21" rx="2" fill="var(--card-bg)" stroke="currentColor" stroke-width="2" />
          <path d="M16 17.5h9" stroke="var(--stamp)" stroke-width="2" />
        </svg>
        <span class="brand-name">สนามซ้อม <span>Matchup</span></span>
      </a>
      <nav aria-label="เมนูหลัก">
        {
          nav.map((n) => (
            <a href={n.href} aria-current={path === n.href || (n.href !== '/' && path.startsWith(n.href)) ? 'page' : undefined}>
              {n.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="colophon">
      <p>
        เว็บแฟนเมด ไม่หากำไร ไม่เกี่ยวข้องกับ The Pokémon Company, Nintendo, Creatures หรือ GAME FREAK ·
        รูปและข้อความการ์ดเป็นของเจ้าของลิขสิทธิ์ ดึงจาก TCGdex และ pokemontcg.io
      </p>
      <p>เจอกฎหรือการ์ดทำงานผิด <a href={ISSUES} rel="noopener">แจ้งปัญหา</a></p>
    </footer>
  </body>
</html>

<style is:global>
  /* Formal and quiet: a neutral paper page, navy for actions, crimson only where something needs the eye;
     square corners, hairline rules, a serif for headings, tabular figures for numbers. */
  :root {
    --paper: #f6f5f2;
    --paper-deep: #ecebe6;
    --ink: #15181d;
    --ink-soft: #5b616b;
    --rule: #e3e1db;
    --line: #d2d0c8;
    --stamp: #a8231c;
    --teal: #1f6b5e;
    --primary: #1d3a5f;
    --primary-ink: #ffffff;
    --press: #13283f;
    --accent: #d1a23a;
    --accent-ink: #1a1408;
    --card-bg: #ffffff;
    --radius: 4px;
    --shadow: 0 1px 2px #15181d12;
    --shadow-lg: 0 20px 44px -24px #15181d66, 0 2px 6px -2px #15181d14;
    --font-heading: 'Noto Serif Thai', 'IBM Plex Sans Thai', serif;
    --font-display: 'IBM Plex Sans Thai', 'Leelawadee UI', 'Noto Sans Thai', sans-serif;
    --font-body: 'IBM Plex Sans Thai', 'Leelawadee UI', 'Noto Sans Thai', sans-serif;
    --font-mono: 'IBM Plex Mono', ui-monospace, monospace;

    --t-grass: #3f8a3a;
    --t-fire: #d24e2b;
    --t-water: #2b7bbd;
    --t-lightning: #e3b11f;
    --t-psychic: #94509a;
    --t-fighting: #b0612c;
    --t-darkness: #2e3a3c;
    --t-metal: #858d93;
    --t-dragon: #a9842b;
    --t-fairy: #d27aab;
    --t-colorless: #c9c3b3;
    color-scheme: light;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #121418;
      --paper-deep: #1b1e24;
      --ink: #e6e7ea;
      --ink-soft: #9aa0aa;
      --rule: #262a31;
      --line: #333841;
      --stamp: #e06a5f;
      --teal: #5fb8a8;
      --primary: #3d6aa8;
      --press: #2b4f82;
      --accent: #d9b04a;
      --card-bg: #181b20;
      --shadow: 0 1px 2px #0008;
      --shadow-lg: 0 20px 44px -20px #000d;
      color-scheme: dark;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  main {
    flex: 1;
    width: min(1200px, 100%);
    margin: 0 auto;
    padding: 32px 16px 72px;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-heading);
    font-weight: 600;
    /* room for Thai marks above and below the line */
    line-height: 1.3;
    letter-spacing: -0.005em;
  }

  a {
    color: inherit;
  }

  :focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  /* The header: a plain white bar with a hairline under it; the page you are on is underlined. */
  .masthead {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    padding: 0 max(16px, calc((100% - 1200px) / 2 + 16px));
    background: var(--card-bg);
    border-bottom: 1px solid var(--line);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 0;
    color: var(--primary);
    text-decoration: none;
  }

  .brand-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.12rem;
    color: var(--ink);
  }

  .brand-name span {
    font-family: var(--font-body);
    font-weight: 500;
    color: var(--ink-soft);
  }

  .brand-mark {
    width: 26px;
    height: 26px;
    flex: none;
  }

  .masthead nav {
    display: flex;
    gap: 4px;
  }

  .masthead nav a {
    display: flex;
    align-items: center;
    padding: 0 14px;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    color: var(--ink-soft);
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .masthead nav a:hover {
    color: var(--ink);
  }

  .masthead nav a[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
    border-bottom-color: var(--primary);
  }

  /* Phones: brand on its own line, the menu as one row underneath. */
  @media (max-width: 560px) {
    .masthead {
      flex-direction: column;
      gap: 0;
      padding: 0 16px;
    }
    .brand {
      padding: 10px 0 6px;
    }
    .masthead nav {
      margin: 0 -16px;
      padding: 0 8px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .masthead nav a {
      flex: 1 0 auto;
      justify-content: center;
      padding: 8px 10px;
      font-size: 0.9rem;
    }
    main {
      padding-top: 20px;
    }
  }

  .colophon {
    width: min(1200px, 100%);
    margin: 0 auto;
    padding: 20px 16px 28px;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.78rem;
  }

  .colophon p {
    margin: 0 0 2px;
  }

  .mono {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  /* A small label over a heading: plain text in the action colour, no badge. */
  .eyebrow {
    display: block;
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--primary);
    margin: 0 0 6px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .rise {
      animation: rise 0.4s ease-out both;
      animation-delay: calc(var(--i, 0) * 30ms);
    }
    @keyframes rise {
      from {
        opacity: 0;
      }
    }
  }
</style>
