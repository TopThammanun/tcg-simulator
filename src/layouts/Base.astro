---
import { LANG_KEY, langOfPath, localePath, stripLang, tFor } from '../i18n';
import BrandMark from '../components/BrandMark.astro';
import { BRAND, keywords, ldJson, siteUrl, websiteLd, type JsonLd } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  /** The page's own search words, before the site's (lib/seo.ts). */
  words?: string[];
  /** schema.org data for this page, besides the site's own. */
  jsonLd?: JsonLd[];
  /** Send a visitor to their language's version of this page (off for the 404 page, which has both). */
  langRedirect?: boolean;
}
// The page's language comes from its path: /en/… is English (src/pages/[...lang]/), everything else Thai.
const lang = langOfPath(Astro.url.pathname);
const t = tFor(lang);
const {
  title,
  description = t(
    'เล่น Pokémon TCG (PTCG) ฟรีในเบราว์เซอร์ ซ้อม matchup กับบอท AI ที่ใช้ list เด็ค meta จริงจาก Limitless จัดเด็คของคุณเอง แล้วทบทวนเกมด้วย win% ทุกเทิร์น',
    'Play the Pokémon TCG (PTCG) free in your browser: practise matchups against AI bots running real meta decklists from Limitless, build your own deck, and review every turn with win%.',
  ),
  words = [],
  jsonLd = [],
  langRedirect = true,
} = Astro.props;
const path = stripLang(Astro.url.pathname);
const nav = [
  { href: '/', label: t('หน้าแรก', 'Home') },
  { href: '/play/', label: t('เล่น', 'Play') },
  { href: '/decks/', label: t('เด็ค', 'Decks') },
  { href: '/builder/', label: t('จัดเด็ค', 'Deck builder') },
  { href: '/review/', label: t('ประวัติเกม', 'History') },
];
const current = (href: string) => path === href || (href !== '/' && path.startsWith(href));
const ISSUES = 'https://github.com/TopThammanun/tcg-simulator/issues';
const brand = BRAND[lang];
const fullTitle = `${title} · ${brand}`;
// Search engines: this page's address in each language (absolute once `site` is set in astro.config). A visitor
// whose language is neither gets the English page.
const url = siteUrl(Astro.site);
const alternates = [
  { hreflang: 'th', href: url(localePath('th', path)) },
  { hreflang: 'en', href: url(localePath('en', path)) },
  { hreflang: 'x-default', href: url(localePath('en', path)) },
];
const other = lang === 'th' ? 'en' : 'th';
const switchTo = { lang: other, href: localePath(other, path), label: other === 'en' ? 'EN' : 'ไทย', title: other === 'en' ? 'English' : 'ภาษาไทย' };
// The picture a shared link shows: absolute once `site` is set in astro.config (crawlers want a full URL).
const ogImage = url(lang === 'en' ? '/home/board-en.jpg' : '/home/board.jpg');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    {
      langRedirect && (
        <script is:inline define:vars={{ pageLang: lang, key: LANG_KEY }}>
          // The language a visitor reads (Thai at /, English at /en/): the one they picked with the language switch,
          // else Thai for a browser set to Thai or a clock on Thai time, English for everyone else. Crawlers and
          // automated browsers stay on the page they asked for: each language has its own address for search engines.
          try {
            var picked = localStorage.getItem(key);
            if (picked !== 'th' && picked !== 'en') picked = null;
            var robot = navigator.webdriver || /bot|crawl|spider|slurp|lighthouse|headless|preview/i.test(navigator.userAgent);
            if (picked || !robot) {
              var thai =
                (navigator.languages || [navigator.language]).some(function (l) {
                  return /^th\b/i.test(l || '');
                }) || Intl.DateTimeFormat().resolvedOptions().timeZone === 'Asia/Bangkok';
              var want = picked || (thai ? 'th' : 'en');
              var p = location.pathname;
              var bare = p === '/en' || p === '/en/' ? '/' : p.indexOf('/en/') === 0 ? p.slice(3) : p;
              var to = want === 'en' ? (bare === '/' ? '/en/' : '/en' + bare) : bare;
              if (want !== pageLang && to !== p) location.replace(to + location.search + location.hash);
            }
          } catch (e) {
            /* storage or Intl blocked: stay on this page */
          }
        </script>
      )
    }
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords(lang, words)} />
    <meta name="application-name" content={brand} />
    <meta name="theme-color" content="#ffffff" />
    <!-- Light only: a browser's own dark mode (Chrome's auto-dark) must not recolour it. -->
    <meta name="color-scheme" content="only light" />
    <link rel="canonical" href={url(localePath(lang, path))} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand} />
    <meta property="og:url" content={url(localePath(lang, path))} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'th_TH'} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'th_TH' : 'en_US'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1440" />
    <meta property="og:image:height" content="900" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {[websiteLd(lang, url), ...jsonLd].map((d) => <script type="application/ld+json" set:html={ldJson(d)} />)}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- The card pictures' hosts (data/cards.manifest.json, src/ui/card-back.ts): connected before the first picture. -->
    <link rel="preconnect" href="https://assets.tcgdex.net" />
    <link rel="preconnect" href="https://images.pokemontcg.io" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&family=Noto+Sans+Thai:wght@400;500;600;700&display=swap"
    />
    <title>{fullTitle}</title>
    <!-- Reveal animations only when scripts run, so the page never stays hidden. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">{t('ข้ามไปเนื้อหา', 'Skip to content')}</a>
    <header class="nav-wrap">
      <nav class="nav" aria-label={t('เมนูหลัก', 'Main menu')}>
        <a class="brand" href={localePath(lang, '/')}>
          <BrandMark />
          <span class="wordmark">MyTrainer<span class="gym">Gym</span></span>
        </a>
        <div class="links" id="nav-links">
          {
            nav.map((n, i) => (
              <a href={localePath(lang, n.href)} style={`--i:${i}`} aria-current={current(n.href) ? 'page' : undefined}>
                {n.label}
              </a>
            ))
          }
          <a class="lang-switch" href={switchTo.href} hreflang={switchTo.lang} lang={switchTo.lang} title={switchTo.title} style={`--i:${nav.length}`}>
            {switchTo.label}
          </a>
        </div>
        <button type="button" class="toggle" aria-expanded="false" aria-controls="nav-links" aria-label={t('เปิดเมนู', 'Open the menu')}>
          <span></span><span></span>
        </button>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="footer-inner">
        <div>
          <a class="brand" href={localePath(lang, '/')}>
            <BrandMark size={24} />
            <span class="wordmark">MyTrainer<span class="gym">Gym</span></span>
          </a>
          <p class="caption-5 legal">
            {
              t(
                'ยิมซ้อม Pokémon TCG ของเทรนเนอร์ เว็บแฟนเมด ไม่หากำไร ไม่เกี่ยวข้องกับ The Pokémon Company, Nintendo, Creatures หรือ GAME FREAK รูปและข้อความการ์ดเป็นของเจ้าของลิขสิทธิ์ ดึงจาก TCGdex, pokemontcg.io และ Limitless',
                'The Pokémon TCG training gym. A non-profit fan site, not affiliated with The Pokémon Company, Nintendo, Creatures or GAME FREAK. Card images and text belong to their owners, loaded from TCGdex, pokemontcg.io and Limitless.',
              )
            }
          </p>
        </div>
        <nav class="footer-links" aria-label={t('ลิงก์ท้ายเว็บ', 'Footer links')}>
          {nav.slice(1).map((n) => <a href={localePath(lang, n.href)}>{n.label}</a>)}
          <a href={ISSUES} rel="noopener">{t('แจ้งปัญหา', 'Report a problem')}</a>
          <a class="lang-switch" href={switchTo.href} hreflang={switchTo.lang} lang={switchTo.lang}>{switchTo.title}</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<script>
  import { LANG_KEY } from '../i18n';

  // Phones: the menu opens as a full height panel; the toggle's two lines turn into a cross.
  const toggle = document.querySelector<HTMLButtonElement>('.nav .toggle');
  const root = document.documentElement;
  const en = root.lang === 'en';
  const setOpen = (open: boolean) => {
    root.classList.toggle('menu-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? (en ? 'Close the menu' : 'ปิดเมนู') : en ? 'Open the menu' : 'เปิดเมนู');
  };
  // The other language's link keeps this page's query (/play/?opp=…) and anchor (/decks/#mine), and the language
  // picked is remembered: the head's script sends a visitor to it from then on, whatever their browser's language.
  document.querySelectorAll<HTMLAnchorElement>('a.lang-switch').forEach((a) => {
    a.href = a.pathname + location.search + location.hash;
    a.addEventListener('click', () => {
      try {
        localStorage.setItem(LANG_KEY, a.hreflang);
      } catch {
        /* storage blocked: the browser's language decides next time */
      }
    });
  });
  toggle?.addEventListener('click', () => setOpen(!root.classList.contains('menu-open')));
  document.querySelectorAll('#nav-links a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  matchMedia('(min-width: 641px)').addEventListener('change', () => setOpen(false));

  // Sections marked .reveal rise into place once, when they enter the screen.
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        e.target.classList.add('in');
        io.unobserve(e.target);
      }
    },
    { rootMargin: '0px 0px -10% 0px' },
  );
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
</script>

<style is:global>
  /* One light, flat theme in a Pokémon Center's colours: a white page, #F6F6F6 surfaces, hairline borders, near
     black ink, and one red. Card art brings the other colours; red is the brand, the one main action, what can be
     played or picked and your side; blue is the bot, your rival; a deeper red is for danger, amber for a warning.
     The play mat stays dark (.dark below), like a mat on the shop's white table, so the cards stand out.
     One type family: Geist for Latin and figures, Noto Sans Thai for Thai (the browser picks per glyph). */
  :root {
    --paper: #ffffff;
    --paper-deep: #f2f2f2;
    --card-bg: #f6f6f6;
    --raised: #ffffff;
    --control: #ececec;
    --ink: #2b2b2b;
    --ink-strong: #111111;
    --ink-soft: #626262;
    --ink-faint: #8a8a8a;
    --rule: #ebebeb;
    --line: #dedede;
    --stamp: #cf1f2b;
    --teal: #1e874b;
    /* MyTrainerGym's colour: a Pokémon Center red, for the brand, the one main action and what can be played. */
    --brand: #e3121f;
    --brand-deep: #b30d18;
    --primary: var(--brand);
    --primary-ink: #ffffff;
    --press: #c40f1b;
    --accent: var(--brand);
    --accent-ink: #ffffff;
    /* A warning (a turn worth a look, a gamble): amber, deep enough to read on white. */
    --warn: #9c6600;
    --warn-ink: #ffffff;
    --radius: 8px;
    --radius-lg: 12px;
    --radius-xl: 16px;
    --radius-sm: 4px;
    /* The one size under the text scale: numbers and labels drawn on a card (HP, a Tool's name). */
    --fs-card: 11px;
    --control-hover: #e1e1e1;
    --line-strong: #c6c6c6;
    --stamp-press: #ad1822;
    /* By meaning: what can be played or picked, your side, the bot's side (the rival's blue), HP left. */
    --can: var(--accent);
    --mine: var(--brand);
    --rival: #2a6fdb;
    --theirs: var(--rival);
    --hp-ok: #3f9b5a;
    --hp-hurt: #c8941f;
    --hp-low: #c3352b;
    /* A card's own paper (a Tool's tab peeking out of a Pokémon in play). */
    --card-paper: #e4ddcc;
    --card-paper-ink: #2a261e;
    --shadow: 0 1px 2px #0000001f;
    --shadow-lg: 0 24px 48px -16px #00000040;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --font-body: 'Geist', 'Noto Sans Thai', 'Leelawadee UI', sans-serif;
    --font-heading: var(--font-body);
    --font-display: var(--font-body);
    --font-mono: 'Geist Mono', 'Noto Sans Thai', ui-monospace, monospace;

    --t-grass: #3f8a3a;
    --t-fire: #d24e2b;
    --t-water: #2b7bbd;
    --t-lightning: #e3b11f;
    --t-psychic: #94509a;
    --t-fighting: #b0612c;
    --t-darkness: #2e3a3c;
    --t-metal: #858d93;
    --t-dragon: #a9842b;
    --t-fairy: #d27aab;
    --t-colorless: #c9c3b3;
    color-scheme: light;
  }
  /* The play mat and what opens over it (a Pokémon's menu, the Prize pick, the full screen replay): the dark
     surfaces and light ink they were drawn for. */
  .dark {
    --paper: #000000;
    --paper-deep: #1f1f1f;
    --card-bg: #181818;
    --raised: #1f1f1f;
    --control: #272727;
    --control-hover: #313131;
    --ink: #ededed;
    --ink-strong: #ffffff;
    --ink-soft: #9b9b9b;
    --ink-faint: #6e6e6e;
    --rule: #272727;
    --line: #313131;
    --line-strong: #4a4a4a;
    --stamp: #e5484d;
    --stamp-press: #c93c41;
    --teal: #4cc38a;
    --warn: #ffc845;
    --warn-ink: #1a1300;
    --rival: #5b9bff;
    --theirs: var(--rival);
    --shadow: 0 1px 2px #0009;
    --shadow-lg: 0 24px 48px -16px #000;
    color-scheme: dark;
    color: var(--ink);
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 24px;
    -webkit-font-smoothing: antialiased;
  }

  main {
    flex: 1;
    width: min(1200px, 100%);
    margin: 0 auto;
    padding: 48px 16px 96px;
  }

  h1,
  h2,
  h3,
  h4 {
    color: var(--ink-strong);
    font-weight: 600;
    text-wrap: balance;
  }

  p {
    text-wrap: pretty;
  }

  a {
    color: inherit;
  }

  ::selection {
    background: color-mix(in srgb, var(--brand) 22%, transparent);
  }

  :focus-visible {
    outline: 2px solid var(--ink-strong);
    outline-offset: 2px;
  }

  /* Text styles (one scale; Thai needs more room above and below the line than Latin, so headings get 1.25). */
  .heading-1 {
    font-size: 60px;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .heading-3 {
    font-size: 36px;
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .heading-4 {
    font-size: 30px;
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .heading-5 {
    font-size: 24px;
    line-height: 32px;
    font-weight: 600;
  }
  .heading-6 {
    font-size: 20px;
    line-height: 28px;
    font-weight: 600;
  }
  .title-1 {
    font-size: 20px;
    line-height: 28px;
    font-weight: 500;
  }
  .title-2 {
    font-size: 18px;
    line-height: 28px;
    font-weight: 500;
  }
  .title-3 {
    font-size: 16px;
    line-height: 24px;
    font-weight: 500;
  }
  .title-4 {
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
  }
  .body-3 {
    font-size: 16px;
    line-height: 24px;
    font-weight: 400;
  }
  .body-6 {
    font-size: 14px;
    line-height: 20px;
    font-weight: 400;
  }
  .body-7 {
    font-size: 18px;
    line-height: 28px;
    font-weight: 400;
  }
  .caption-3 {
    font-size: 12px;
    line-height: 16px;
    font-weight: 600;
  }
  .caption-4 {
    font-size: 12px;
    line-height: 16px;
    font-weight: 500;
  }
  .caption-5 {
    font-size: 12px;
    line-height: 16px;
    font-weight: 400;
  }
  @media (max-width: 640px) {
    .heading-1 {
      font-size: 30px;
    }
    .heading-3 {
      font-size: 30px;
    }
    .heading-4 {
      font-size: 24px;
    }
  }

  /* Buttons: red for the one main action, grey for the rest. */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--control);
    color: var(--ink-strong);
    font: inherit;
    font-size: 16px;
    line-height: 24px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 0.3s var(--ease),
      border-color 0.3s var(--ease),
      transform 0.3s var(--ease);
  }
  .btn:hover {
    background: var(--control-hover);
  }
  .btn:active {
    transform: scale(0.98);
  }
  .btn.primary {
    border-color: var(--primary);
    background: var(--primary);
    color: var(--primary-ink);
  }
  .btn.primary:hover {
    border-color: var(--press);
    background: var(--press);
  }
  .btn.sm {
    padding: 4px 12px;
    font-size: 14px;
    line-height: 20px;
  }

  .skip {
    position: absolute;
    left: 16px;
    top: -48px;
    z-index: 60;
    padding: 8px 12px;
    border-radius: var(--radius);
    background: var(--primary);
    color: var(--primary-ink);
    font-weight: 600;
  }
  .skip:focus {
    top: 16px;
  }

  /* The header: a compact bar floating off the top, centred, over a blur. */
  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 25;
    display: flex;
    justify-content: center;
    padding: 12px 16px 0;
    pointer-events: none;
  }
  /* The blur sits on a layer behind the bar: on the bar itself it would make the bar the box that the phone
     menu (position: fixed) fills, instead of the screen. */
  .nav {
    position: relative;
    z-index: 0;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    pointer-events: auto;
  }
  .nav::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: #ffffffcc;
    box-shadow: var(--shadow);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    backdrop-filter: blur(16px) saturate(140%);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px 4px 8px;
    color: var(--ink-strong);
    font-size: 14px;
    line-height: 20px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .brand-mark {
    flex: none;
  }
  .wordmark {
    letter-spacing: -0.01em;
  }
  .wordmark .gym {
    color: var(--brand);
  }
  .links {
    display: flex;
    gap: 4px;
  }
  .links a {
    padding: 4px 12px;
    border-radius: var(--radius);
    color: var(--ink-soft);
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.3s var(--ease),
      background-color 0.3s var(--ease);
  }
  .links a:hover {
    color: var(--ink-strong);
  }
  .links a[aria-current='page'] {
    background: var(--control);
    color: var(--brand);
  }
  /* The other language, set apart from the pages. */
  .links .lang-switch {
    margin-left: 4px;
    border-left: 1px solid var(--line);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .toggle {
    display: none;
    position: relative;
    width: 32px;
    height: 28px;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: none;
    cursor: pointer;
  }
  .toggle span {
    position: absolute;
    left: 8px;
    width: 16px;
    height: 2px;
    border-radius: 1px;
    background: var(--ink-strong);
    transition: transform 0.5s var(--ease);
  }
  .toggle span:first-child {
    transform: translateY(-3px);
  }
  .toggle span:last-child {
    transform: translateY(3px);
  }
  .menu-open .toggle span:first-child {
    transform: rotate(45deg);
  }
  .menu-open .toggle span:last-child {
    transform: rotate(-45deg);
  }
  @media (max-width: 640px) {
    .nav {
      width: 100%;
      justify-content: space-between;
    }
