---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'ซ้อม matchup Pokémon TCG กับบอทที่เล่นเด็คใน meta ในเบราว์เซอร์' } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'หน้าแรก' },
  { href: '/play/', label: 'เล่น' },
  { href: '/decks/', label: 'เด็ค' },
  { href: '/review/', label: 'ประวัติเกม' },
];
const ISSUES = 'https://github.com/TopThammanun/tcg-simulator/issues';
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anuphan:wght@400;500;600&family=Mitr:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    />
    <title>{title} · สนามซ้อม Matchup</title>
  </head>
  <body>
    <header class="masthead">
      <a class="brand" href="/">
        <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
          <rect x="4" y="6" width="15" height="21" rx="3" transform="rotate(-14 11.5 16.5)" fill="#e3412f" stroke="#fff" stroke-width="1.6" />
          <rect x="13" y="5" width="15" height="21" rx="3" transform="rotate(10 20.5 15.5)" fill="#ffcb2f" stroke="#fff" stroke-width="1.6" />
          <path d="M20.6 10.5l-3 5.3h2.6l-1.4 5 3.9-6.3h-2.7z" fill="#16213e" />
        </svg>
        สนามซ้อม <em>Matchup</em>
      </a>
      <nav aria-label="เมนูหลัก">
        {
          nav.map((n) => (
            <a href={n.href} aria-current={path === n.href || (n.href !== '/' && path.startsWith(n.href)) ? 'page' : undefined}>
              {n.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="colophon">
      เว็บแฟนเมด ไม่หากำไร ไม่เกี่ยวข้องกับ The Pokémon Company, Nintendo, Creatures หรือ GAME FREAK · รูปและข้อความการ์ดเป็นของเจ้าของลิขสิทธิ์
      ดึงจาก TCGdex และ pokemontcg.io · เจอกฎหรือการ์ดทำงานผิด <a href={ISSUES} rel="noopener">แจ้งปัญหา</a>
    </footer>
  </body>
</html>

<style is:global>
  /* Bright and friendly: a sky-blue page, white rounded panels, blue pill buttons with a pressed edge, a yellow
     accent and a red for emphasis; the header a deep blue band. */
  :root {
    --paper: #f2f6fd;
    --paper-deep: #e1eaf8;
    --ink: #16213e;
    --ink-soft: #56627e;
    --rule: #d3deef;
    --line: #c5d4eb;
    --stamp: #e3412f;
    --teal: #1d7a6e;
    --primary: #2b62d6;
    --primary-ink: #ffffff;
    --press: #1b3f98;
    --accent: #ffcb2f;
    --accent-ink: #1b2440;
    --band: #1c3b8c;
    --band-deep: #132a68;
    --card-bg: #ffffff;
    --radius: 16px;
    --shadow: 0 1px 2px #1b3a6b14, 0 10px 24px -14px #1b3a6b55;
    --shadow-lg: 0 20px 44px -18px #0f2a5c77;
    --font-display: 'Mitr', 'Anuphan', sans-serif;
    --font-body: 'Anuphan', 'Leelawadee UI', 'Noto Sans Thai', sans-serif;
    --font-mono: 'IBM Plex Mono', ui-monospace, monospace;

    --t-grass: #3f8a3a;
    --t-fire: #d24e2b;
    --t-water: #2b7bbd;
    --t-lightning: #e3b11f;
    --t-psychic: #94509a;
    --t-fighting: #b0612c;
    --t-darkness: #2e3a3c;
    --t-metal: #858d93;
    --t-dragon: #a9842b;
    --t-fairy: #d27aab;
    --t-colorless: #c9c3b3;
    color-scheme: light;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #0d1530;
      --paper-deep: #17213f;
      --ink: #e9eefb;
      --ink-soft: #9ba9c8;
      --rule: #26345a;
      --line: #2e3f6b;
      --stamp: #ff6655;
      --teal: #4fc0b0;
      --primary: #3d7bff;
      --press: #1d47a8;
      --band: #142c6e;
      --band-deep: #0c1c4a;
      --card-bg: #142043;
      --shadow: 0 10px 24px -14px #000c;
      --shadow-lg: 0 20px 44px -18px #000e;
      color-scheme: dark;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: var(--paper);
    /* a fine dot grid over a light wash from the header down */
    background-image:
      radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--primary) 10%, transparent) 1px, transparent 0),
      linear-gradient(180deg, var(--paper-deep), var(--paper) 480px);
    background-size: 22px 22px, 100% 100%;
    background-repeat: repeat, no-repeat;
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
  }

  main {
    flex: 1;
    width: min(1200px, 100%);
    margin: 0 auto;
    padding: 24px 16px 64px;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.2;
  }

  a {
    color: inherit;
  }

  :focus-visible {
    outline: 2px solid var(--stamp);
    outline-offset: 2px;
  }

  /* The header: a deep blue band across the page with a yellow edge; the content inside it stays 1200px wide. */
  .masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    padding: 12px max(16px, calc((100% - 1200px) / 2 + 16px));
    background: linear-gradient(180deg, var(--band), var(--band-deep));
    border-bottom: 4px solid var(--accent);
    color: #fff;
    box-shadow: 0 6px 18px -10px #0b1a4a99;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.2rem;
    text-decoration: none;
  }

  .brand em {
    font-style: normal;
    color: var(--accent);
  }

  .brand-mark {
    width: 30px;
    height: 30px;
    flex: none;
  }

  .masthead nav {
    display: flex;
    gap: 6px;
  }

  .masthead nav a {
    font-family: var(--font-display);
    font-weight: 500;
    text-decoration: none;
    padding: 5px 16px;
    border-radius: 999px;
    color: #dfe7ff;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .masthead nav a:hover {
    background: #ffffff1f;
    color: #fff;
  }

  .masthead nav a[aria-current='page'] {
    background: var(--accent);
    color: var(--accent-ink);
    box-shadow: 0 3px 0 #c99a12;
  }

  .masthead nav a {
    white-space: nowrap;
  }

  /* Phones: brand on its own line, the menu as one row underneath. */
  @media (max-width: 560px) {
    .masthead {
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
      padding: 10px 16px 10px;
    }
    .masthead nav {
      margin: 0 -16px;
      padding: 0 16px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .masthead nav a {
      flex: 1 0 auto;
      padding: 6px 10px;
      text-align: center;
      font-size: 0.9rem;
    }
    main {
      padding-top: 16px;
    }
  }

  .colophon {
    width: min(1200px, 100%);
    margin: 0 auto;
    padding: 16px;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.8rem;
  }

  .mono {
    font-family: var(--font-mono);
  }

  .eyebrow {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--accent-ink);
    background: var(--accent);
    padding: 2px 12px;
    border-radius: 999px;
    margin: 0 0 10px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .rise {
      animation: rise 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: calc(var(--i, 0) * 40ms);
    }
    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
    }
  }
</style>
